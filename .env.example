# Runtime connection: the non-owner role "estate_app", which is bound by row-level security.
DATABASE_URL="postgresql://estate_app:CHANGE_ME@localhost:5432/estate"
# Migrations run as the database owner.
MIGRATION_DATABASE_URL="postgresql://estate_owner:CHANGE_ME@localhost:5432/estate"
# Only needed for `npm run db:check-drift`.
SHADOW_DATABASE_URL="postgresql://estate_owner:CHANGE_ME@localhost:5432/estate_shadow"

# Where uploaded documents are stored (outside the public folder).
STORAGE_DIR="./storage"

# Product name, kept in one place until the brand is final.
NEXT_PUBLIC_PLATFORM_NAME="[Platform Name]"

# Verification modal rules (master prompt Section 9).
VERIFY_DECLINE_DAYS=90
VERIFY_LATER_HOURS=24
VERIFY_RECOMMEND_RENTALS=false

# Used by `npm run db:seed` to create the first Platform Super Super Admin.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-this-password"
# Set to "true" to also create clearly labelled demonstration companies and listings.
SEED_DEMO_DATA=false
