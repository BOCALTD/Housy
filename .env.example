# Database host and name. The app replaces the user and password with the restricted
# role "estate_app" and APP_DB_PASSWORD, so row-level security always applies.
DATABASE_URL="postgresql://estate_owner:CHANGE_ME@localhost:5432/estate"
# Owner connection used to create estate_app and run migrations (direct, not pooled).
MIGRATION_DATABASE_URL="postgresql://estate_owner:CHANGE_ME@localhost:5432/estate"
# Password for estate_app. Random, at least 24 characters, no quotes or backslashes.
APP_DB_PASSWORD="CHANGE_ME_to_a_long_random_value"
# Unlocks the one-time /setup page that creates the first platform administrator.
SETUP_TOKEN="CHANGE_ME_to_another_long_random_value"
# Only needed for `npm run db:check-drift`.
SHADOW_DATABASE_URL="postgresql://estate_owner:CHANGE_ME@localhost:5432/estate_shadow"

# Product name, kept in one place until the brand is final.
NEXT_PUBLIC_PLATFORM_NAME="Housy"

# Verification modal rules (master prompt Section 9).
VERIFY_DECLINE_DAYS=90
VERIFY_LATER_HOURS=24
VERIFY_RECOMMEND_RENTALS=false

# Used by `npm run db:seed` (local development) to create the first Platform Super Super Admin.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-this-password"
# Set to "true" to also create clearly labelled demonstration companies and listings.
SEED_DEMO_DATA=false
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
REQUIRE_ADMIN_MFA=false
SUPPORT_EMAIL=""
# Who runs the service, shown on /legal/terms and /legal/privacy (registered company name and address), and where privacy requests go.
LEGAL_ENTITY_NAME=""
LEGAL_ADDRESS=""
PRIVACY_EMAIL=""
SUPPORT_PHONE=""
SUPPORT_HOURS=""
MFA_ENCRYPTION_KEY=""
RESEND_API_KEY=""
EMAIL_FROM=""
PAYSTACK_SECRET_KEY=""
# Optional: Stripe, for businesses outside Paystack's countries (US, UK, Canada, Europe, Australia, UAE). These can also be
# entered in Admin -> Settings instead; values here take priority.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
CRON_SECRET=""
UNSUBSCRIBE_SECRET=""
NEXT_PUBLIC_APP_URL=""

# Automatic identity and business checks (KYC). Optional: without keys every check is reviewed by a person.
# Keys come from YOUR account with the provider. Checks are only sent when the person ticks the box agreeing to it.
# Dojah (NIN, CAC registration, TIN): https://dojah.io  — sandbox base URL https://sandbox.dojah.io
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
# DOJAH_BASE_URL=https://api.dojah.io
# Youverify (NIN, voter's card, driver's licence): https://youverify.co — sandbox base URL https://api.sandbox.youverify.co
YOUVERIFY_TOKEN=
# YOUVERIFY_BASE_URL=https://api.youverify.co
# Order to try them in; if one is down or cannot check a record, the next is tried, then a person reviews it.
# KYC_PROVIDERS=dojah,youverify

# Satellite layer for the maps. Not needed with MapTiler: its key in NEXT_PUBLIC_MAP_TILES also gives the satellite (hybrid) layer.
# NEXT_PUBLIC_MAP_SATELLITE_TILES=https://your-provider/{z}/{x}/{y}.jpg?key=...
# NEXT_PUBLIC_MAP_SATELLITE_TILE_SIZE=256
# NEXT_PUBLIC_MAP_SATELLITE_ATTRIBUTION=© Your provider
# Nearby places on property pages (schools, hospitals, markets...) come from OpenStreetMap through Overpass, cached 30 days.
# Nearby places use the free public OpenStreetMap servers. They need to know who is asking: set NEXT_PUBLIC_APP_URL to
# the site's https address, and OVERPASS_CONTACT to an email they can reach you on. For heavy use, run your own server
# (or a paid one) and list it here; several can be given, separated by commas.
# OVERPASS_CONTACT=ops@example.com
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# NEARBY_PLACES=off
# Real driving times: an OSRM-compatible routing server (your own, or a provider's). Without it, times are estimates.
# ROUTING_URL=https://router.example.ng

# Development server only: extra addresses (host names or IPs, comma separated) allowed to open "npm run dev",
# e.g. the server's public IP. Not needed for the production server.
DEV_ORIGINS=""
