# /etc/housy/housy.env  -- owned by root, mode 0640, group housy. Never commit the real file.
NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1

# Local PostgreSQL. install.sh generates the passwords and writes this file for you.
DATABASE_URL="postgresql://estate_owner:OWNER_PASSWORD@127.0.0.1:5432/estate"
MIGRATION_DATABASE_URL="postgresql://estate_owner:OWNER_PASSWORD@127.0.0.1:5432/estate"
APP_DB_PASSWORD="GENERATED_24_PLUS_CHARACTERS"

NEXT_PUBLIC_APP_URL="https://your-domain.example"
NEXT_PUBLIC_PLATFORM_NAME="Your Product Name"

MFA_ENCRYPTION_KEY="GENERATED_32_PLUS_CHARACTERS"
REQUIRE_ADMIN_MFA=true
CRON_SECRET="GENERATED_24_PLUS_CHARACTERS"
UNSUBSCRIBE_SECRET="GENERATED_24_PLUS_CHARACTERS"
# Push notifications. install.sh generates the pair; to make one by hand run: npx tsx scripts/vapid-keys.ts
# Keep the pair for good: changing it means everyone has to turn notifications on again.
VAPID_PUBLIC_KEY="GENERATED"
VAPID_PRIVATE_KEY="GENERATED"
VAPID_SUBJECT=""
# Remove SETUP_TOKEN after the first administrator exists.
SETUP_TOKEN="GENERATED_24_PLUS_CHARACTERS"

SUPPORT_EMAIL=""
SUPPORT_PHONE=""
SUPPORT_HOURS=""

# Fill in when the providers are ready.
RESEND_API_KEY=""
EMAIL_FROM=""
PAYSTACK_SECRET_KEY=""
ANTHROPIC_API_KEY=""
