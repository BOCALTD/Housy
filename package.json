{
  "name": "real-estate-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant real estate marketplace and asset management CRM. First end-to-end vertical slice.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "typecheck": "prisma generate && tsc --noEmit",
    "db:migrate": "DATABASE_URL=\"$MIGRATION_DATABASE_URL\" prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "check:nearby": "tsx scripts/check-nearby.ts",
    "admin:password": "tsx scripts/admin-password.ts",
    "nearby:warm": "tsx scripts/nearby-warm.ts",
    "db:check-drift": "prisma migrate diff --from-migrations prisma/migrations --to-schema prisma/schema.prisma --exit-code",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:rls": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f tests/sql/rls.test.sql",
    "start:server": "next start -H 127.0.0.1 -p 3000",
    "db:setup": "node scripts/db-setup.mjs",
    "db:seed:demo": "tsx prisma/seed-demo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1150.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@types/nodemailer": "7.0.3",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "bcryptjs": "2.4.3",
    "bwip-js": "4.11.4",
    "leaflet": "1.9.4",
    "next": "16.4.6",
    "nodemailer": "10.3.1",
    "pg": "8.23.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "sharp": "^0.35.5",
    "sonner": "2.0.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/bcryptjs": "2.4.6",
    "@types/leaflet": "1.9.12",
    "@types/node": "22.9.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "prisma": "7.10.1",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}
