// Data model for the first end-to-end vertical slice (master prompt Section 51).
// Every tenant-owned table carries company_id and is protected twice:
//   1. the application scopes every query by company (src/lib/db.ts), and
//   2. PostgreSQL row-level security (prisma/migrations/*_rls) rejects rows from other companies.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Identity and multi-tenancy ----------

enum MemberRole {
  COMPANY_SUPER_ADMIN
  MANAGER
  AGENT
  OFFICER
  VIEWER
}

enum MemberStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id              String       @id @default(uuid())
  email           String       @unique
  name            String
  passwordHash    String       @map("password_hash")
  isPlatformAdmin Boolean      @default(false) @map("is_platform_admin")
  createdAt       DateTime     @default(now()) @map("created_at")
  /// Two-step sign-in: the secret is stored encrypted; it only counts once mfaEnabledAt is set. mfaLastStep stops a code being used twice.
  mfaSecret       String?      @map("mfa_secret")
  mfaEnabledAt    DateTime?    @map("mfa_enabled_at")
  mfaLastStep     BigInt?      @map("mfa_last_step")
  sessions        Session[]
  memberships     Membership[]
  passwordResets  PasswordReset[]
  mfaRecoveries   MfaRecovery[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  companyId String?  @map("company_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Company {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  // Organization prefix used in correspondence references, for example "ALP" in ALP/LEG/2026/0007.
  refPrefix   String       @default("REF") @map("ref_prefix")
  // Reminders (Section 13.4): how many days ahead something shows as due soon, and how many days
  // overdue before it is escalated to administrators.
  reminderLeadDays Int     @default(30) @map("reminder_lead_days")
  escalationDays   Int     @default(7) @map("escalation_days")
  /// Set by a platform administrator: the workspace is closed and the company's listings and profiles are hidden until restored.
  suspendedAt      DateTime? @map("suspended_at")
  suspendedReason  String    @default("") @map("suspended_reason")
  suspendedById    String?   @map("suspended_by_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  memberships Membership[]
  invitations Invitation[]
  assets      Asset[]

  @@map("companies")
}

model Membership {
  id        String       @id @default(uuid())
  companyId String       @map("company_id")
  userId    String       @map("user_id")
  role      MemberRole   @default(VIEWER)
  status    MemberStatus @default(ACTIVE)
  departmentId String?   @map("department_id")
  branchId  String?      @map("branch_id")
  teamId    String?      @map("team_id")
  createdAt DateTime     @default(now()) @map("created_at")
  branch    Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  team      Team?        @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  tasks     Task[]       @relation("TaskAssignee")
  inspections Inspection[] @relation("InspectionInspector")
  workOrders  WorkOrder[]  @relation("WorkOrderAssignee")
  schedules   PreventiveSchedule[] @relation("ScheduleAssignee")
  correspondence Correspondence[] @relation("CorrespondenceAssignee")
  heldFiles PhysicalFile[] @relation("FileHolder")

  @@unique([companyId, userId])
  @@index([userId])
  @@map("memberships")
  custodianOf         InventoryItem[]     @relation("ItemCustodian")
}

model Invitation {
  id          String     @id @default(uuid())
  companyId   String     @map("company_id")
  email       String
  role        MemberRole
  tokenHash   String     @unique @map("token_hash")
  invitedById String     @map("invited_by_id")
  expiresAt   DateTime   @map("expires_at")
  acceptedAt  DateTime?  @map("accepted_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("invitations")
}

// ---------- Asset register ----------

enum AssetClass {
  RESIDENTIAL
  COMMERCIAL
  LAND
  INDUSTRIAL
  PLANT_MACHINERY
  OTHER
}

enum AssetStatus {
  ACTIVE
  VACANT
  OCCUPIED
  UNDER_RENOVATION
  DISPOSED
  ARCHIVED
}

// How the company holds this asset. Managing a property never makes the company its owner.
enum CompanyRelationship {
  OWNER
  MANAGER
  CUSTODIAN
  LISTING_AGENT
}

model Asset {
  id                  String              @id @default(uuid())
  companyId           String              @map("company_id")
  ref                 String
  name                String
  assetClass          AssetClass          @map("asset_class")
  category            String
  description         String              @default("")
  address             String              @default("")
  city                String              @default("")
  state               String              @default("")
  lat                 Float?
  lng                 Float?
  status              AssetStatus         @default(ACTIVE)
  companyRelationship CompanyRelationship @map("company_relationship")
  acquisitionCostKobo BigInt?             @map("acquisition_cost_kobo")
  acquiredOn          DateTime?           @map("acquired_on") @db.Date
  createdById         String              @map("created_by_id")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  company             Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  parties             AssetParty[]
  documents           AssetDocument[]
  leases              Lease[]
  serviceCharges      ServiceChargePeriod[]
  obligations         Obligation[]
  inspections         Inspection[]
  workOrders          WorkOrder[]
  preventiveSchedules PreventiveSchedule[]
  tasks               Task[]
  listing             Listing?
  correspondence      Correspondence[]
  files               PhysicalFile[]

  @@unique([companyId, ref])
  @@index([companyId, status])
  @@map("assets")
  inventoryItems      InventoryItem[]
  valuations          ValuationInstruction[]
  projects            Project[]
  deals            Deal[]
}

enum PartyRelationship {
  LEGAL_OWNER
  BENEFICIAL_OWNER
  PROPERTY_MANAGER
  CUSTODIAN
  LESSEE
  LISTING_AGENT
  MAINTENANCE_RESPONSIBLE
  INCOME_COLLECTOR
}

model AssetParty {
  id            String            @id @default(uuid())
  companyId     String            @map("company_id")
  assetId       String            @map("asset_id")
  partyName     String            @map("party_name")
  relationship  PartyRelationship
  effectiveFrom DateTime?         @map("effective_from") @db.Date
  effectiveTo   DateTime?         @map("effective_to") @db.Date
  evidenceNote  String            @default("") @map("evidence_note")
  createdAt     DateTime          @default(now()) @map("created_at")
  asset         Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([companyId, assetId])
  @@map("asset_parties")
}

enum DocumentCategory {
  TITLE_OWNERSHIP
  LEASE_AGREEMENT
  MANAGEMENT_AGREEMENT
  SURVEY_PLAN
  VALUATION_REPORT
  INSPECTION_REPORT
  INSURANCE
  TAX_RECEIPT
  PERMIT_APPROVAL
  CORRESPONDENCE
  OTHER
}

model AssetDocument {
  id           String           @id @default(uuid())
  companyId    String           @map("company_id")
  assetId      String           @map("asset_id")
  category     DocumentCategory
  title        String
  fileName     String           @map("file_name")
  mimeType     String           @map("mime_type")
  sizeBytes    Int              @map("size_bytes")
  storageKey   String           @unique @map("storage_key")
  version      Int              @default(1)
  expiresOn    DateTime?        @map("expires_on") @db.Date
  uploadedById String           @map("uploaded_by_id")
  createdAt    DateTime         @default(now()) @map("created_at")
  asset        Asset            @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([companyId, assetId])
  @@map("asset_documents")
}

// Uploaded file contents, kept in the database so the app runs on hosts without a disk.
model StoredFile {
  key       String   @id
  companyId String   @map("company_id")
  bytes     Bytes
  createdAt DateTime @default(now()) @map("created_at")

  @@index([companyId])
  @@map("stored_files")
}

// ---------- Tenancy and rent ----------

enum RentFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  CUSTOM
}

enum LeaseStatus {
  ACTIVE
  ENDED
  TERMINATED
}

model Lease {
  id            String        @id @default(uuid())
  companyId     String        @map("company_id")
  assetId       String        @map("asset_id")
  ref           String
  occupantName  String        @map("occupant_name")
  occupantContact String      @default("") @map("occupant_contact")
  startDate     DateTime      @map("start_date") @db.Date
  endDate       DateTime      @map("end_date") @db.Date
  rentKobo      BigInt        @map("rent_kobo")
  frequency     RentFrequency
  depositKobo   BigInt        @default(0) @map("deposit_kobo")
  status        LeaseStatus   @default(ACTIVE)
  // Contract terms (master prompt Section 12.1). A blank unit means the whole property.
  unit           String       @default("")
  graceDays      Int          @default(0) @map("grace_days")
  noticeDays     Int          @default(0) @map("notice_days")
  intervalMonths Int?         @map("interval_months")
  permittedUse   String       @default("") @map("permitted_use")
  otherTerms     String       @default("") @map("other_terms")
  // Closure (Section 12.3) and renewal chain. A renewal is a new lease that points back at the old one.
  // Whole square metres, used when a service charge is shared by floor area.
  floorAreaSqm   Int?         @map("floor_area_sqm")
  closedOn       DateTime?    @map("closed_on") @db.Date
  closeReason    String       @default("") @map("close_reason")
  renewedFromId  String?      @unique @map("renewed_from_id")
  createdById   String        @map("created_by_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  asset         Asset         @relation(fields: [assetId], references: [id], onDelete: Restrict)
  renewedFrom   Lease?        @relation("Renewal", fields: [renewedFromId], references: [id], onDelete: Restrict)
  renewedTo     Lease?        @relation("Renewal")
  charges       RentCharge[]
  receipts      Receipt[]
  depositEntries DepositEntry[]
  renewals      LeaseRenewal[]
  notices       LeaseNotice[]
  handovers     LeaseHandover[]
  serviceAssessments ServiceAssessment[]

  @@unique([companyId, ref])
  @@index([companyId, assetId])
  @@map("leases")
  handoverSchedules   HandoverSchedule[]
}

model RentCharge {
  id         String        @id @default(uuid())
  companyId  String        @map("company_id")
  leaseId    String        @map("lease_id")
  dueDate    DateTime      @map("due_date") @db.Date
  amountKobo BigInt        @map("amount_kobo")
  // Sum of approved adjustments (late fees add, waivers and credit notes subtract).
  adjustedKobo BigInt      @default(0) @map("adjusted_kobo")
  paidKobo   BigInt        @default(0) @map("paid_kobo")
  lease      Lease         @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  payments   RentPayment[]
  adjustments RentAdjustment[]

  @@index([companyId, dueDate])
  @@index([leaseId])
  @@map("rent_charges")
}

// One row per charge a receipt was applied to. Insert-only.
model RentPayment {
  id           String     @id @default(uuid())
  companyId    String     @map("company_id")
  chargeId     String     @map("charge_id")
  receiptId    String     @map("receipt_id")
  amountKobo   BigInt     @map("amount_kobo")
  paidOn       DateTime   @map("paid_on") @db.Date
  evidence     String
  recordedById String     @map("recorded_by_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  charge       RentCharge @relation(fields: [chargeId], references: [id], onDelete: Restrict)
  receipt      Receipt    @relation(fields: [receiptId], references: [id], onDelete: Restrict)

  @@index([chargeId])
  @@index([receiptId])
  @@map("rent_payments")
}

// Per-company running numbers (receipts and similar), allocated atomically.
model NumberCounter {
  companyId  String @map("company_id")
  kind       String
  year       Int
  lastNumber Int    @default(0) @map("last_number")

  @@id([companyId, kind, year])
  @@map("number_counters")
}

// A receipt is money received against a lease. It never changes after it is issued: reconciliation and
// reversal are recorded as separate insert-only rows.
model Receipt {
  id             String        @id @default(uuid())
  companyId      String        @map("company_id")
  leaseId        String        @map("lease_id")
  no             String
  amountKobo     BigInt        @map("amount_kobo")
  paidOn         DateTime      @map("paid_on") @db.Date
  method         String        @default("")
  payerName      String        @default("") @map("payer_name")
  evidence       String
  evidenceKey    String        @map("evidence_key")
  recordedById   String        @map("recorded_by_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  lease          Lease         @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  allocations    RentPayment[]
  reconciliation ReceiptReconciliation?
  reversal       ReceiptReversal?

  @@unique([companyId, no])
  @@index([companyId, evidenceKey])
  @@index([leaseId])
  @@map("receipts")
}

// Confirms a receipt against a bank statement line. Done by someone other than the person who recorded it.
model ReceiptReconciliation {
  id             String   @id @default(uuid())
  companyId      String   @map("company_id")
  receiptId      String   @unique @map("receipt_id")
  statementRef   String   @map("statement_ref")
  note           String   @default("")
  reconciledById String   @map("reconciled_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  receipt        Receipt  @relation(fields: [receiptId], references: [id], onDelete: Restrict)

  @@map("receipt_reconciliations")
}

model ReceiptReversal {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  receiptId    String   @unique @map("receipt_id")
  reason       String
  reversedById String   @map("reversed_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  receipt      Receipt  @relation(fields: [receiptId], references: [id], onDelete: Restrict)

  @@map("receipt_reversals")
}

enum AdjustmentKind {
  LATE_FEE
  WAIVER
  CREDIT_NOTE
  CORRECTION
}

enum AdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
}

// A change to the amount due on one charge. It takes effect only when someone other than the requester approves it.
model RentAdjustment {
  id            String           @id @default(uuid())
  companyId     String           @map("company_id")
  chargeId      String           @map("charge_id")
  kind          AdjustmentKind
  amountKobo    BigInt           @map("amount_kobo")
  reason        String
  status        AdjustmentStatus @default(PENDING)
  requestedById String           @map("requested_by_id")
  decidedById   String?          @map("decided_by_id")
  decidedAt     DateTime?        @map("decided_at")
  decisionNote  String           @default("") @map("decision_note")
  createdAt     DateTime         @default(now()) @map("created_at")
  charge        RentCharge       @relation(fields: [chargeId], references: [id], onDelete: Restrict)

  @@index([companyId, status])
  @@index([chargeId])
  @@map("rent_adjustments")
}

enum DepositEntryKind {
  RECEIVED
  DEDUCTION
  REFUND
}

// Security deposit ledger. Insert-only: the balance is received minus deductions minus refunds.
model DepositEntry {
  id           String           @id @default(uuid())
  companyId    String           @map("company_id")
  leaseId      String           @map("lease_id")
  kind         DepositEntryKind
  amountKobo   BigInt           @map("amount_kobo")
  reason       String           @default("")
  evidence     String           @default("")
  entryDate    DateTime         @map("entry_date") @db.Date
  recordedById String           @map("recorded_by_id")
  createdAt    DateTime         @default(now()) @map("created_at")
  lease        Lease            @relation(fields: [leaseId], references: [id], onDelete: Restrict)

  @@index([leaseId])
  @@map("deposit_entries")
}

// ---------- Tasks, inspections, maintenance ----------

enum TaskKind {
  TASK
  INSPECTION
  MAINTENANCE
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

model Task {
  id          String       @id @default(uuid())
  companyId   String       @map("company_id")
  assetId     String       @map("asset_id")
  kind        TaskKind
  title       String
  description String       @default("")
  priority    TaskPriority @default(NORMAL)
  status      TaskStatus   @default(OPEN)
  assigneeId  String?      @map("assignee_id")
  dueOn       DateTime?    @map("due_on") @db.Date
  outcome     String       @default("")
  createdById String       @map("created_by_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  asset       Asset        @relation(fields: [assetId], references: [id], onDelete: Restrict)
  assignee    Membership?  @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  dealId      String?      @map("deal_id")
  @@index([companyId, status])
  @@index([assetId])
  @@index([companyId, dealId])
  @@map("tasks")
}

// ---------- Audit ----------

// Insert-only: the runtime database role has no UPDATE or DELETE on this table.
model ActivityLog {
  id         String   @id @default(uuid())
  companyId  String?  @map("company_id")
  actorId    String?  @map("actor_id")
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  action     String
  detail     Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([companyId, entityType, entityId])
  @@index([companyId, createdAt])
  @@map("activity_log")
}

// ---------- Public marketplace ----------

enum ListingPurpose {
  SALE
  RENT
  LEASE
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  UNAVAILABLE
  ARCHIVED
}

model Listing {
  id          String         @id @default(uuid())
  companyId   String         @map("company_id")
  assetId     String         @unique @map("asset_id")
  publicRef   String         @unique @map("public_ref")
  title       String
  purpose     ListingPurpose
  priceKobo   BigInt         @map("price_kobo")
  bedrooms    Int?
  bathrooms   Int?
  description String         @default("")
  city        String
  state       String
  /// Two-letter country code (ISO 3166-1). The platform starts in Nigeria.
  country     String         @default("NG")
  /// Listing details (master prompt §7). Codes and labels live in src/lib/listing-rules.ts.
  propertyType       String    @default("OTHER") @map("property_type")
  pricePeriod        String    @default("TOTAL") @map("price_period")
  negotiable         Boolean   @default(false)
  depositKobo        BigInt?   @map("deposit_kobo")
  serviceChargeKobo  BigInt?   @map("service_charge_kobo")
  feesNote           String    @default("") @map("fees_note")
  toilets            Int?
  floors             Int?
  buildingSqm        Int?      @map("building_sqm")
  landSqm            Int?      @map("land_sqm")
  plotDimensions     String    @default("") @map("plot_dimensions")
  furnishing         String    @default("UNSPECIFIED")
  condition          String    @default("UNSPECIFIED")
  constructionStatus String    @default("COMPLETED") @map("construction_status")
  serviced           Boolean   @default(false)
  amenities          String    @default("")
  titleDocument      String    @default("UNSPECIFIED") @map("title_document")
  availableFrom      DateTime? @map("available_from") @db.Date
  minLeaseMonths     Int?      @map("min_lease_months")
  estateName         String    @default("") @map("estate_name")
  videoUrl           String    @default("") @map("video_url")
  /// Hidden from the public while the company is suspended (the listing keeps its own status underneath).
  platformHidden     Boolean   @default(false) @map("platform_hidden")
  /// Approximate position only (rounded to about 1 km). The exact position of an asset is never published.
  lat         Float?
  lng         Float?
  status      ListingStatus  @default(DRAFT)
  reviewNote  String         @default("") @map("review_note")
  postedById  String?        @map("posted_by_id")
  publishedAt DateTime?      @map("published_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  asset       Asset          @relation(fields: [assetId], references: [id], onDelete: Restrict)
  enquiries   Enquiry[]
  adCampaigns AdCampaign[]
  photos      ListingPhoto[]

  @@index([status, city])
  @@index([status, propertyType])
  @@index([publishedAt(sort: Desc)])
  @@index([status, lat, lng])
  @@map("listings")
}

/// Public photographs of a listing. Position 0 is the cover (the front view). Visible to everyone only while the listing is published.
model ListingPhoto {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  listingId String   @map("listing_id")
  mimeType  String   @map("mime_type")
  bytes     Bytes
  caption   String   @default("")
  position  Int      @default(0)
  /// PHOTO or FLOOR_PLAN.
  kind      String   @default("PHOTO")
  createdAt DateTime @default(now()) @map("created_at")
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Restrict)

  @@index([listingId, position])
  @@map("listing_photos")
}

model Enquiry {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  listingId String   @map("listing_id")
  name      String
  contact   String
  message   String
  adCampaignId String? @map("ad_campaign_id")
  createdAt DateTime @default(now()) @map("created_at")
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Restrict)

  @@index([companyId, createdAt])
  @@index([adCampaignId])
  @@map("enquiries")
}

// ---------- Verification services (master prompt Section 9) ----------
// Platform-level tables: not owned by a tenant company.

enum ProviderStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum PlacementLabel {
  SPONSORED
  AFFILIATED
  EDITORIAL
}

model ServiceProvider {
  id         String         @id @default(uuid())
  name       String
  shortName  String         @map("short_name")
  profile    String         @default("")
  services   String         @default("")
  coverage   String         @default("")
  link       String         @default("")
  status     ProviderStatus @default(PENDING)
  placement  PlacementLabel @default(EDITORIAL)
  featured   Boolean        @default(false)
  createdAt  DateTime       @default(now()) @map("created_at")
  events     RecommendationEvent[]
  leads      ProviderLead[]

  @@map("service_providers")
}

enum RecommendationEventType {
  IMPRESSION
  CONFIRMED_INTEREST
  DECLINED
  LATER
}

model RecommendationEvent {
  id           String                  @id @default(uuid())
  providerId   String                  @map("provider_id")
  listingRef   String                  @map("listing_ref")
  userId       String?                 @map("user_id")
  visitorKey   String                  @map("visitor_key")
  trigger      String
  modalVersion String                  @map("modal_version")
  event        RecommendationEventType
  preselected  Boolean                 @default(false)
  createdAt    DateTime                @default(now()) @map("created_at")
  provider     ServiceProvider         @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@index([providerId, event])
  @@map("recommendation_events")
}

enum LeadStatus {
  SUBMITTED
  CONTACTED
  IN_PROGRESS
  CLOSED
  WITHDRAWN
  DECLINED
}

model ProviderLead {
  id                    String          @id @default(uuid())
  ref                   String          @unique
  accessTokenHash       String          @map("access_token_hash")
  providerId            String          @map("provider_id")
  listingRef            String          @map("listing_ref")
  userId                String?         @map("user_id")
  name                  String
  contactMethod         String          @map("contact_method")
  contactValue          String          @map("contact_value")
  note                  String          @default("")
  consentTextVersion    String          @map("consent_text_version")
  consentGivenAt        DateTime        @map("consent_given_at")
  status                LeadStatus      @default(SUBMITTED)
