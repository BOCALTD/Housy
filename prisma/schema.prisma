// Data model for the first end-to-end vertical slice (master prompt Section 51).
// Every tenant-owned table carries company_id and is protected twice:
//   1. the application scopes every query by company (src/lib/db.ts), and
//   2. PostgreSQL row-level security (prisma/migrations/*_rls) rejects rows from other companies.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Identity and multi-tenancy ----------

enum MemberRole {
  COMPANY_SUPER_ADMIN
  MANAGER
  AGENT
  OFFICER
  VIEWER
}

enum MemberStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id              String       @id @default(uuid())
  email           String       @unique
  name            String
  passwordHash    String       @map("password_hash")
  isPlatformAdmin Boolean      @default(false) @map("is_platform_admin")
  createdAt       DateTime     @default(now()) @map("created_at")
  sessions        Session[]
  memberships     Membership[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  companyId String?  @map("company_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Company {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  // Organization prefix used in correspondence references, for example "ALP" in ALP/LEG/2026/0007.
  refPrefix   String       @default("REF") @map("ref_prefix")
  createdAt   DateTime     @default(now()) @map("created_at")
  memberships Membership[]
  invitations Invitation[]
  assets      Asset[]

  @@map("companies")
}

model Membership {
  id        String       @id @default(uuid())
  companyId String       @map("company_id")
  userId    String       @map("user_id")
  role      MemberRole   @default(VIEWER)
  status    MemberStatus @default(ACTIVE)
  departmentId String?   @map("department_id")
  createdAt DateTime     @default(now()) @map("created_at")
  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  tasks     Task[]       @relation("TaskAssignee")
  correspondence Correspondence[] @relation("CorrespondenceAssignee")
  heldFiles PhysicalFile[] @relation("FileHolder")

  @@unique([companyId, userId])
  @@index([userId])
  @@map("memberships")
}

model Invitation {
  id          String     @id @default(uuid())
  companyId   String     @map("company_id")
  email       String
  role        MemberRole
  tokenHash   String     @unique @map("token_hash")
  invitedById String     @map("invited_by_id")
  expiresAt   DateTime   @map("expires_at")
  acceptedAt  DateTime?  @map("accepted_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("invitations")
}

// ---------- Asset register ----------

enum AssetClass {
  RESIDENTIAL
  COMMERCIAL
  LAND
  INDUSTRIAL
  PLANT_MACHINERY
  OTHER
}

enum AssetStatus {
  ACTIVE
  VACANT
  OCCUPIED
  UNDER_RENOVATION
  DISPOSED
  ARCHIVED
}

// How the company holds this asset. Managing a property never makes the company its owner.
enum CompanyRelationship {
  OWNER
  MANAGER
  CUSTODIAN
  LISTING_AGENT
}

model Asset {
  id                  String              @id @default(uuid())
  companyId           String              @map("company_id")
  ref                 String
  name                String
  assetClass          AssetClass          @map("asset_class")
  category            String
  description         String              @default("")
  address             String              @default("")
  city                String              @default("")
  state               String              @default("")
  status              AssetStatus         @default(ACTIVE)
  companyRelationship CompanyRelationship @map("company_relationship")
  acquisitionCostKobo BigInt?             @map("acquisition_cost_kobo")
  acquiredOn          DateTime?           @map("acquired_on") @db.Date
  createdById         String              @map("created_by_id")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  company             Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  parties             AssetParty[]
  documents           AssetDocument[]
  leases              Lease[]
  serviceCharges      ServiceChargePeriod[]
  tasks               Task[]
  listing             Listing?
  correspondence      Correspondence[]
  files               PhysicalFile[]

  @@unique([companyId, ref])
  @@index([companyId, status])
  @@map("assets")
}

enum PartyRelationship {
  LEGAL_OWNER
  BENEFICIAL_OWNER
  PROPERTY_MANAGER
  CUSTODIAN
  LESSEE
  LISTING_AGENT
  MAINTENANCE_RESPONSIBLE
  INCOME_COLLECTOR
}

model AssetParty {
  id            String            @id @default(uuid())
  companyId     String            @map("company_id")
  assetId       String            @map("asset_id")
  partyName     String            @map("party_name")
  relationship  PartyRelationship
  effectiveFrom DateTime?         @map("effective_from") @db.Date
  effectiveTo   DateTime?         @map("effective_to") @db.Date
  evidenceNote  String            @default("") @map("evidence_note")
  createdAt     DateTime          @default(now()) @map("created_at")
  asset         Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([companyId, assetId])
  @@map("asset_parties")
}

enum DocumentCategory {
  TITLE_OWNERSHIP
  LEASE_AGREEMENT
  MANAGEMENT_AGREEMENT
  SURVEY_PLAN
  VALUATION_REPORT
  INSPECTION_REPORT
  INSURANCE
  TAX_RECEIPT
  PERMIT_APPROVAL
  CORRESPONDENCE
  OTHER
}

model AssetDocument {
  id           String           @id @default(uuid())
  companyId    String           @map("company_id")
  assetId      String           @map("asset_id")
  category     DocumentCategory
  title        String
  fileName     String           @map("file_name")
  mimeType     String           @map("mime_type")
  sizeBytes    Int              @map("size_bytes")
  storageKey   String           @unique @map("storage_key")
  version      Int              @default(1)
  expiresOn    DateTime?        @map("expires_on") @db.Date
  uploadedById String           @map("uploaded_by_id")
  createdAt    DateTime         @default(now()) @map("created_at")
  asset        Asset            @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([companyId, assetId])
  @@map("asset_documents")
}

// Uploaded file contents, kept in the database so the app runs on hosts without a disk.
model StoredFile {
  key       String   @id
  companyId String   @map("company_id")
  bytes     Bytes
  createdAt DateTime @default(now()) @map("created_at")

  @@index([companyId])
  @@map("stored_files")
}

// ---------- Tenancy and rent ----------

enum RentFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  CUSTOM
}

enum LeaseStatus {
  ACTIVE
  ENDED
  TERMINATED
}

model Lease {
  id            String        @id @default(uuid())
  companyId     String        @map("company_id")
  assetId       String        @map("asset_id")
  ref           String
  occupantName  String        @map("occupant_name")
  occupantContact String      @default("") @map("occupant_contact")
  startDate     DateTime      @map("start_date") @db.Date
  endDate       DateTime      @map("end_date") @db.Date
  rentKobo      BigInt        @map("rent_kobo")
  frequency     RentFrequency
  depositKobo   BigInt        @default(0) @map("deposit_kobo")
  status        LeaseStatus   @default(ACTIVE)
  // Contract terms (master prompt Section 12.1). A blank unit means the whole property.
  unit           String       @default("")
  graceDays      Int          @default(0) @map("grace_days")
  noticeDays     Int          @default(0) @map("notice_days")
  intervalMonths Int?         @map("interval_months")
  permittedUse   String       @default("") @map("permitted_use")
  otherTerms     String       @default("") @map("other_terms")
  // Closure (Section 12.3) and renewal chain. A renewal is a new lease that points back at the old one.
  // Whole square metres, used when a service charge is shared by floor area.
  floorAreaSqm   Int?         @map("floor_area_sqm")
  closedOn       DateTime?    @map("closed_on") @db.Date
  closeReason    String       @default("") @map("close_reason")
  renewedFromId  String?      @unique @map("renewed_from_id")
  createdById   String        @map("created_by_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  asset         Asset         @relation(fields: [assetId], references: [id], onDelete: Restrict)
  renewedFrom   Lease?        @relation("Renewal", fields: [renewedFromId], references: [id], onDelete: Restrict)
  renewedTo     Lease?        @relation("Renewal")
  charges       RentCharge[]
  receipts      Receipt[]
  depositEntries DepositEntry[]
  renewals      LeaseRenewal[]
  notices       LeaseNotice[]
  handovers     LeaseHandover[]
  serviceAssessments ServiceAssessment[]

  @@unique([companyId, ref])
  @@index([companyId, assetId])
  @@map("leases")
}

model RentCharge {
  id         String        @id @default(uuid())
  companyId  String        @map("company_id")
  leaseId    String        @map("lease_id")
  dueDate    DateTime      @map("due_date") @db.Date
  amountKobo BigInt        @map("amount_kobo")
  // Sum of approved adjustments (late fees add, waivers and credit notes subtract).
  adjustedKobo BigInt      @default(0) @map("adjusted_kobo")
  paidKobo   BigInt        @default(0) @map("paid_kobo")
  lease      Lease         @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  payments   RentPayment[]
  adjustments RentAdjustment[]

  @@index([companyId, dueDate])
  @@index([leaseId])
  @@map("rent_charges")
}

// One row per charge a receipt was applied to. Insert-only.
model RentPayment {
  id           String     @id @default(uuid())
  companyId    String     @map("company_id")
  chargeId     String     @map("charge_id")
  receiptId    String     @map("receipt_id")
  amountKobo   BigInt     @map("amount_kobo")
  paidOn       DateTime   @map("paid_on") @db.Date
  evidence     String
  recordedById String     @map("recorded_by_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  charge       RentCharge @relation(fields: [chargeId], references: [id], onDelete: Restrict)
  receipt      Receipt    @relation(fields: [receiptId], references: [id], onDelete: Restrict)

  @@index([chargeId])
  @@index([receiptId])
  @@map("rent_payments")
}

// Per-company running numbers (receipts and similar), allocated atomically.
model NumberCounter {
  companyId  String @map("company_id")
  kind       String
  year       Int
  lastNumber Int    @default(0) @map("last_number")

  @@id([companyId, kind, year])
  @@map("number_counters")
}

// A receipt is money received against a lease. It never changes after it is issued: reconciliation and
// reversal are recorded as separate insert-only rows.
model Receipt {
  id             String        @id @default(uuid())
  companyId      String        @map("company_id")
  leaseId        String        @map("lease_id")
  no             String
  amountKobo     BigInt        @map("amount_kobo")
  paidOn         DateTime      @map("paid_on") @db.Date
  method         String        @default("")
  payerName      String        @default("") @map("payer_name")
  evidence       String
  evidenceKey    String        @map("evidence_key")
  recordedById   String        @map("recorded_by_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  lease          Lease         @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  allocations    RentPayment[]
  reconciliation ReceiptReconciliation?
  reversal       ReceiptReversal?

  @@unique([companyId, no])
  @@index([companyId, evidenceKey])
  @@index([leaseId])
  @@map("receipts")
}

// Confirms a receipt against a bank statement line. Done by someone other than the person who recorded it.
model ReceiptReconciliation {
  id             String   @id @default(uuid())
  companyId      String   @map("company_id")
  receiptId      String   @unique @map("receipt_id")
  statementRef   String   @map("statement_ref")
  note           String   @default("")
  reconciledById String   @map("reconciled_by_id")
  createdAt      DateTime @default(now()) @map("created_at")
  receipt        Receipt  @relation(fields: [receiptId], references: [id], onDelete: Restrict)

  @@map("receipt_reconciliations")
}

model ReceiptReversal {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  receiptId    String   @unique @map("receipt_id")
  reason       String
  reversedById String   @map("reversed_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  receipt      Receipt  @relation(fields: [receiptId], references: [id], onDelete: Restrict)

  @@map("receipt_reversals")
}

enum AdjustmentKind {
  LATE_FEE
  WAIVER
  CREDIT_NOTE
  CORRECTION
}

enum AdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
}

// A change to the amount due on one charge. It takes effect only when someone other than the requester approves it.
model RentAdjustment {
  id            String           @id @default(uuid())
  companyId     String           @map("company_id")
  chargeId      String           @map("charge_id")
  kind          AdjustmentKind
  amountKobo    BigInt           @map("amount_kobo")
  reason        String
  status        AdjustmentStatus @default(PENDING)
  requestedById String           @map("requested_by_id")
  decidedById   String?          @map("decided_by_id")
  decidedAt     DateTime?        @map("decided_at")
  decisionNote  String           @default("") @map("decision_note")
  createdAt     DateTime         @default(now()) @map("created_at")
  charge        RentCharge       @relation(fields: [chargeId], references: [id], onDelete: Restrict)

  @@index([companyId, status])
  @@index([chargeId])
  @@map("rent_adjustments")
}

enum DepositEntryKind {
  RECEIVED
  DEDUCTION
  REFUND
}

// Security deposit ledger. Insert-only: the balance is received minus deductions minus refunds.
model DepositEntry {
  id           String           @id @default(uuid())
  companyId    String           @map("company_id")
  leaseId      String           @map("lease_id")
  kind         DepositEntryKind
  amountKobo   BigInt           @map("amount_kobo")
  reason       String           @default("")
  evidence     String           @default("")
  entryDate    DateTime         @map("entry_date") @db.Date
  recordedById String           @map("recorded_by_id")
  createdAt    DateTime         @default(now()) @map("created_at")
  lease        Lease            @relation(fields: [leaseId], references: [id], onDelete: Restrict)

  @@index([leaseId])
  @@map("deposit_entries")
}

// ---------- Tasks, inspections, maintenance ----------

enum TaskKind {
  TASK
  INSPECTION
  MAINTENANCE
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

model Task {
  id          String       @id @default(uuid())
  companyId   String       @map("company_id")
  assetId     String       @map("asset_id")
  kind        TaskKind
  title       String
  description String       @default("")
  priority    TaskPriority @default(NORMAL)
  status      TaskStatus   @default(OPEN)
  assigneeId  String?      @map("assignee_id")
  dueOn       DateTime?    @map("due_on") @db.Date
  outcome     String       @default("")
  createdById String       @map("created_by_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  asset       Asset        @relation(fields: [assetId], references: [id], onDelete: Restrict)
  assignee    Membership?  @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([assetId])
  @@map("tasks")
}

// ---------- Audit ----------

// Insert-only: the runtime database role has no UPDATE or DELETE on this table.
model ActivityLog {
  id         String   @id @default(uuid())
  companyId  String?  @map("company_id")
  actorId    String?  @map("actor_id")
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  action     String
  detail     Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([companyId, entityType, entityId])
  @@index([companyId, createdAt])
  @@map("activity_log")
}

// ---------- Public marketplace ----------

enum ListingPurpose {
  SALE
  RENT
  LEASE
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  UNAVAILABLE
  ARCHIVED
}

model Listing {
  id          String         @id @default(uuid())
  companyId   String         @map("company_id")
  assetId     String         @unique @map("asset_id")
  publicRef   String         @unique @map("public_ref")
  title       String
  purpose     ListingPurpose
  priceKobo   BigInt         @map("price_kobo")
  bedrooms    Int?
  bathrooms   Int?
  description String         @default("")
  city        String
  state       String
  status      ListingStatus  @default(DRAFT)
  reviewNote  String         @default("") @map("review_note")
  publishedAt DateTime?      @map("published_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  asset       Asset          @relation(fields: [assetId], references: [id], onDelete: Restrict)
  enquiries   Enquiry[]

  @@index([status, city])
  @@map("listings")
}

model Enquiry {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  listingId String   @map("listing_id")
  name      String
  contact   String
  message   String
  createdAt DateTime @default(now()) @map("created_at")
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Restrict)

  @@index([companyId, createdAt])
  @@map("enquiries")
}

// ---------- Verification services (master prompt Section 9) ----------
// Platform-level tables: not owned by a tenant company.

enum ProviderStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum PlacementLabel {
  SPONSORED
  AFFILIATED
  EDITORIAL
}

model ServiceProvider {
  id         String         @id @default(uuid())
  name       String
  shortName  String         @map("short_name")
  profile    String         @default("")
  services   String         @default("")
  coverage   String         @default("")
  link       String         @default("")
  status     ProviderStatus @default(PENDING)
  placement  PlacementLabel @default(EDITORIAL)
  featured   Boolean        @default(false)
  createdAt  DateTime       @default(now()) @map("created_at")
  events     RecommendationEvent[]
  leads      ProviderLead[]

  @@map("service_providers")
}

enum RecommendationEventType {
  IMPRESSION
  CONFIRMED_INTEREST
  DECLINED
  LATER
}

model RecommendationEvent {
  id           String                  @id @default(uuid())
  providerId   String                  @map("provider_id")
  listingRef   String                  @map("listing_ref")
  userId       String?                 @map("user_id")
  visitorKey   String                  @map("visitor_key")
  trigger      String
  modalVersion String                  @map("modal_version")
  event        RecommendationEventType
  preselected  Boolean                 @default(false)
  createdAt    DateTime                @default(now()) @map("created_at")
  provider     ServiceProvider         @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@index([providerId, event])
  @@map("recommendation_events")
}

enum LeadStatus {
  SUBMITTED
  CONTACTED
  IN_PROGRESS
  CLOSED
  WITHDRAWN
  DECLINED
}

model ProviderLead {
  id                    String          @id @default(uuid())
  ref                   String          @unique
  accessTokenHash       String          @map("access_token_hash")
  providerId            String          @map("provider_id")
  listingRef            String          @map("listing_ref")
  userId                String?         @map("user_id")
  name                  String
  contactMethod         String          @map("contact_method")
  contactValue          String          @map("contact_value")
  note                  String          @default("")
  consentTextVersion    String          @map("consent_text_version")
  consentGivenAt        DateTime        @map("consent_given_at")
  status                LeadStatus      @default(SUBMITTED)
  withdrawnAt           DateTime?       @map("withdrawn_at")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")
  provider              ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@index([providerId, status])
  @@map("provider_leads")
}

// ---------- Departments (master prompt Section 3.2) ----------

model Department {
  id          String           @id @default(uuid())
  companyId   String           @map("company_id")
  name        String
  code        String
  createdAt   DateTime         @default(now()) @map("created_at")
  members     Membership[]
  correspondence Correspondence[]
  files       PhysicalFile[]

  @@unique([companyId, code])
  @@map("departments")
}

// ---------- Correspondence register (master prompt Section 11) ----------

enum CorrespondenceDirection {
  INCOMING
  OUTGOING
}

enum CorrespondenceStatus {
  REGISTERED
  ASSIGNED
  UNDER_REVIEW
  RESPONSE_REQUIRED
  DRAFT_RESPONSE
  AWAITING_APPROVAL
  APPROVED
  SENT
  AWAITING_REPLY
  CLOSED
}

enum CorrespondencePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model CorrespondenceCounter {
  companyId  String @map("company_id")
  year       Int
  lastNumber Int    @default(0) @map("last_number")

  @@id([companyId, year])
  @@map("correspondence_counters")
}

model Correspondence {
  id               String                  @id @default(uuid())
  companyId        String                  @map("company_id")
  ref              String
  direction        CorrespondenceDirection
  subject          String
  description      String                  @default("")
  category         String                  @default("General")
  priority         CorrespondencePriority  @default(NORMAL)
  confidential     Boolean                 @default(false)
  status           CorrespondenceStatus
  senderName       String                  @map("sender_name")
  recipientName    String                  @map("recipient_name")
  copiedTo         String                  @default("") @map("copied_to")
  externalRef      String                  @default("") @map("external_ref")
  dateReceived     DateTime?               @map("date_received") @db.Date
  dateIssued       DateTime?               @map("date_issued") @db.Date
  responseDeadline DateTime?               @map("response_deadline") @db.Date
  assetId          String?                 @map("asset_id")
  departmentId     String?                 @map("department_id")
  assigneeId       String?                 @map("assignee_id")
  requiredAction   String                  @default("") @map("required_action")
  draftResponse    String                  @default("") @map("draft_response")
  draftedById      String?                 @map("drafted_by_id")
  approvedById     String?                 @map("approved_by_id")
  approvedAt       DateTime?               @map("approved_at")
  dispatchMethod   String                  @default("") @map("dispatch_method")
  dispatchedAt     DateTime?               @map("dispatched_at") @db.Date
  closedAt         DateTime?               @map("closed_at")
  closureNote      String                  @default("") @map("closure_note")
  createdById      String                  @map("created_by_id")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")
  asset            Asset?                  @relation(fields: [assetId], references: [id], onDelete: Restrict)
  department       Department?             @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignee         Membership?             @relation("CorrespondenceAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  actions          CorrespondenceAction[]
  attachments      CorrespondenceAttachment[]

  @@unique([companyId, ref])
  @@index([companyId, status])
  @@index([companyId, responseDeadline])
  @@map("correspondence")
}

model CorrespondenceAction {
  id               String               @id @default(uuid())
  companyId        String               @map("company_id")
  correspondenceId String               @map("correspondence_id")
  kind             String
  fromStatus       CorrespondenceStatus? @map("from_status")
  toStatus         CorrespondenceStatus? @map("to_status")
  note             String               @default("")
  actorId          String               @map("actor_id")
  createdAt        DateTime             @default(now()) @map("created_at")
  correspondence   Correspondence       @relation(fields: [correspondenceId], references: [id], onDelete: Restrict)

  @@index([correspondenceId])
  @@map("correspondence_actions")
}

model CorrespondenceAttachment {
  id               String         @id @default(uuid())
  companyId        String         @map("company_id")
  correspondenceId String         @map("correspondence_id")
  title            String
  fileName         String         @map("file_name")
  mimeType         String         @map("mime_type")
  sizeBytes        Int            @map("size_bytes")
  storageKey       String         @unique @map("storage_key")
  uploadedById     String         @map("uploaded_by_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  correspondence   Correspondence @relation(fields: [correspondenceId], references: [id], onDelete: Restrict)

  @@index([correspondenceId])
  @@map("correspondence_attachments")
}

// ---------- Physical file register (master prompt Section 11.3) ----------

enum FileStatus {
  IN_REGISTRY
  ISSUED
  ARCHIVED
}

model PhysicalFile {
  id           String         @id @default(uuid())
  companyId    String         @map("company_id")
  fileNumber   String         @map("file_number")
  title        String
  location     String         @default("")
  departmentId String?        @map("department_id")
  assetId      String?        @map("asset_id")
  status       FileStatus     @default(IN_REGISTRY)
  holderId     String?        @map("holder_id")
  createdAt    DateTime       @default(now()) @map("created_at")
  department   Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  asset        Asset?         @relation(fields: [assetId], references: [id], onDelete: Restrict)
  holder       Membership?    @relation("FileHolder", fields: [holderId], references: [id], onDelete: SetNull)
  movements    FileMovement[]

  @@unique([companyId, fileNumber])
  @@map("physical_files")
}

model FileMovement {
  id               String       @id @default(uuid())
  companyId        String       @map("company_id")
  fileId           String       @map("file_id")
  holderId         String       @map("holder_id")
  issuedOn         DateTime     @map("issued_on") @db.Date
  expectedReturnOn DateTime     @map("expected_return_on") @db.Date
  returnedOn       DateTime?    @map("returned_on") @db.Date
  purpose          String       @default("")
  issuedById       String       @map("issued_by_id")
  receivedById     String?      @map("received_by_id")
  createdAt        DateTime     @default(now()) @map("created_at")
  file             PhysicalFile @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([companyId, returnedOn])
  @@index([fileId])
  @@map("file_movements")
}

// ---------- Shared rate limiting (works across serverless instances) ----------

model RateLimit {
  key         String   @id
  windowStart DateTime @map("window_start")
  count       Int

  @@map("rate_limits")
}

enum RenewalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NoticeParty {
  TENANT
  LANDLORD
}

enum HandoverKind {
  MOVE_IN
  MOVE_OUT
}

/// A proposed renewal. Approval by a different person creates the new lease.
model LeaseRenewal {
  id              String        @id @default(uuid())
  companyId       String        @map("company_id")
  leaseId         String        @map("lease_id")
  proposedStart   DateTime      @map("proposed_start") @db.Date
  proposedEnd     DateTime      @map("proposed_end") @db.Date
  proposedRentKobo BigInt       @map("proposed_rent_kobo")
  note            String        @default("")
  status          RenewalStatus @default(PENDING)
  requestedById   String        @map("requested_by_id")
  decidedById     String?       @map("decided_by_id")
  decidedAt       DateTime?     @map("decided_at")
  decisionNote    String        @default("") @map("decision_note")
  newLeaseId      String?       @unique @map("new_lease_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  lease           Lease         @relation(fields: [leaseId], references: [id], onDelete: Restrict)

  @@index([companyId, leaseId])
  @@map("lease_renewals")
}

/// A notice to quit, to vacate or of non-renewal. Append-only.
model LeaseNotice {
  id           String      @id @default(uuid())
  companyId    String      @map("company_id")
  leaseId      String      @map("lease_id")
  givenBy      NoticeParty @map("given_by")
  givenOn      DateTime    @map("given_on") @db.Date
  effectiveOn  DateTime    @map("effective_on") @db.Date
  reason       String
  recordedById String      @map("recorded_by_id")
  createdAt    DateTime    @default(now()) @map("created_at")
  lease        Lease       @relation(fields: [leaseId], references: [id], onDelete: Restrict)

  @@index([companyId, leaseId])
  @@map("lease_notices")
}

/// A signed-off move-in or move-out record. Append-only, one of each kind per lease.
model LeaseHandover {
  id                    String       @id @default(uuid())
  companyId             String       @map("company_id")
  leaseId               String       @map("lease_id")
  kind                  HandoverKind
  handoverOn            DateTime     @map("handover_on") @db.Date
  keysCount             Int          @map("keys_count")
  meterReadings         String       @default("") @map("meter_readings")
  conditionNotes        String       @map("condition_notes")
  issues                String       @default("")
  acknowledgedBy        String       @map("acknowledged_by")
  recordedById          String       @map("recorded_by_id")
  createdAt             DateTime     @default(now()) @map("created_at")
  lease                 Lease        @relation(fields: [leaseId], references: [id], onDelete: Restrict)

  @@unique([leaseId, kind])
  @@index([companyId])
  @@map("lease_handovers")
}

enum ServiceMethod {
  EQUAL
  FLOOR_AREA
  FIXED
}

enum ServicePeriodStatus {
  OPEN
  ASSESSED
}

/// A service charge budget for one property and period (master prompt Section 13.1).
model ServiceChargePeriod {
  id           String              @id @default(uuid())
  companyId    String              @map("company_id")
  assetId      String              @map("asset_id")
  name         String
  startDate    DateTime            @map("start_date") @db.Date
  endDate      DateTime            @map("end_date") @db.Date
  budgetKobo   BigInt              @map("budget_kobo")
  method       ServiceMethod
  status       ServicePeriodStatus @default(OPEN)
  assessedAt   DateTime?           @map("assessed_at")
  createdById  String              @map("created_by_id")
  createdAt    DateTime            @default(now()) @map("created_at")
  asset        Asset               @relation(fields: [assetId], references: [id], onDelete: Restrict)
  assessments  ServiceAssessment[]
  expenses     ServiceExpense[]

  @@index([companyId, assetId])
  @@map("service_charge_periods")
}

/// One tenant's share of a period's budget.
model ServiceAssessment {
  id         String              @id @default(uuid())
  companyId  String              @map("company_id")
  periodId   String              @map("period_id")
  leaseId    String              @map("lease_id")
  amountKobo BigInt              @map("amount_kobo")
  dueDate    DateTime            @map("due_date") @db.Date
  createdAt  DateTime            @default(now()) @map("created_at")
  period     ServiceChargePeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  lease      Lease               @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  collections ServiceCollection[]

  @@unique([periodId, leaseId])
  @@index([companyId, leaseId])
  @@map("service_assessments")
}

/// Money collected against an assessment. Append-only; a mistake is reversed, never edited.
model ServiceCollection {
  id           String            @id @default(uuid())
  companyId    String            @map("company_id")
  assessmentId String            @map("assessment_id")
  amountKobo   BigInt            @map("amount_kobo")
  paidOn       DateTime          @map("paid_on") @db.Date
  method       String            @default("")
  evidence     String
  evidenceKey  String            @map("evidence_key")
  recordedById String            @map("recorded_by_id")
  createdAt    DateTime          @default(now()) @map("created_at")
  assessment   ServiceAssessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  reversal     ServiceCollectionReversal?

  @@index([companyId, assessmentId])
  @@index([companyId, evidenceKey])
  @@map("service_collections")
}

model ServiceCollectionReversal {
  id           String            @id @default(uuid())
  companyId    String            @map("company_id")
  collectionId String            @unique @map("collection_id")
  reason       String
  reversedById String            @map("reversed_by_id")
  createdAt    DateTime          @default(now()) @map("created_at")
  collection   ServiceCollection @relation(fields: [collectionId], references: [id], onDelete: Restrict)

  @@map("service_collection_reversals")
}

/// Spending from the service charge fund. Approved by someone other than the requester.
model ServiceExpense {
  id            String              @id @default(uuid())
  companyId     String              @map("company_id")
  periodId      String              @map("period_id")
  description   String
  supplier      String              @default("")
  amountKobo    BigInt              @map("amount_kobo")
  incurredOn    DateTime            @map("incurred_on") @db.Date
  evidence      String
  status        AdjustmentStatus    @default(PENDING)
  requestedById String              @map("requested_by_id")
  decidedById   String?             @map("decided_by_id")
  decidedAt     DateTime?           @map("decided_at")
  decisionNote  String              @default("") @map("decision_note")
  createdAt     DateTime            @default(now()) @map("created_at")
  period        ServiceChargePeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)

  @@index([companyId, periodId])
  @@map("service_expenses")
}
