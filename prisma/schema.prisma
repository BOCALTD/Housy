}

// ---------- Correspondence register (master prompt Section 11) ----------

enum CorrespondenceDirection {
  INCOMING
  OUTGOING
}

enum CorrespondenceStatus {
  REGISTERED
  ASSIGNED
  UNDER_REVIEW
  RESPONSE_REQUIRED
  DRAFT_RESPONSE
  AWAITING_APPROVAL
  APPROVED
  SENT
  AWAITING_REPLY
  CLOSED
}

enum CorrespondencePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model CorrespondenceCounter {
  companyId  String @map("company_id")
  year       Int
  lastNumber Int    @default(0) @map("last_number")

  @@id([companyId, year])
  @@map("correspondence_counters")
}

model Correspondence {
  id               String                  @id @default(uuid())
  companyId        String                  @map("company_id")
  ref              String
  direction        CorrespondenceDirection
  subject          String
  description      String                  @default("")
  category         String                  @default("General")
  priority         CorrespondencePriority  @default(NORMAL)
  confidential     Boolean                 @default(false)
  status           CorrespondenceStatus
  senderName       String                  @map("sender_name")
  recipientName    String                  @map("recipient_name")
  copiedTo         String                  @default("") @map("copied_to")
  externalRef      String                  @default("") @map("external_ref")
  dateReceived     DateTime?               @map("date_received") @db.Date
  dateIssued       DateTime?               @map("date_issued") @db.Date
  responseDeadline DateTime?               @map("response_deadline") @db.Date
  assetId          String?                 @map("asset_id")
  departmentId     String?                 @map("department_id")
  assigneeId       String?                 @map("assignee_id")
  requiredAction   String                  @default("") @map("required_action")
  draftResponse    String                  @default("") @map("draft_response")
  draftedById      String?                 @map("drafted_by_id")
  approvedById     String?                 @map("approved_by_id")
  approvedAt       DateTime?               @map("approved_at")
  dispatchMethod   String                  @default("") @map("dispatch_method")
  dispatchedAt     DateTime?               @map("dispatched_at") @db.Date
  closedAt         DateTime?               @map("closed_at")
  closureNote      String                  @default("") @map("closure_note")
  createdById      String                  @map("created_by_id")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")
  asset            Asset?                  @relation(fields: [assetId], references: [id], onDelete: Restrict)
  department       Department?             @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignee         Membership?             @relation("CorrespondenceAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  actions          CorrespondenceAction[]
  attachments      CorrespondenceAttachment[]

  clientId         String?                 @map("client_id")
  dealId           String?                 @map("deal_id")
  @@unique([companyId, ref])
  @@index([companyId, status])
  @@index([companyId, responseDeadline])
  @@index([companyId, dealId])
  @@index([companyId, clientId])
  @@map("correspondence")
}

model CorrespondenceAction {
  id               String               @id @default(uuid())
  companyId        String               @map("company_id")
  correspondenceId String               @map("correspondence_id")
  kind             String
  fromStatus       CorrespondenceStatus? @map("from_status")
  toStatus         CorrespondenceStatus? @map("to_status")
  note             String               @default("")
  actorId          String               @map("actor_id")
  createdAt        DateTime             @default(now()) @map("created_at")
  correspondence   Correspondence       @relation(fields: [correspondenceId], references: [id], onDelete: Restrict)

  @@index([correspondenceId])
  @@map("correspondence_actions")
}

model CorrespondenceAttachment {
  id               String         @id @default(uuid())
  companyId        String         @map("company_id")
  correspondenceId String         @map("correspondence_id")
  title            String
  fileName         String         @map("file_name")
  mimeType         String         @map("mime_type")
  sizeBytes        Int            @map("size_bytes")
  storageKey       String         @unique @map("storage_key")
  uploadedById     String         @map("uploaded_by_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  correspondence   Correspondence @relation(fields: [correspondenceId], references: [id], onDelete: Restrict)

  @@index([correspondenceId])
  @@map("correspondence_attachments")
}

// ---------- Physical file register (master prompt Section 11.3) ----------

enum FileStatus {
  IN_REGISTRY
  ISSUED
  ARCHIVED
}

model PhysicalFile {
  id           String         @id @default(uuid())
  companyId    String         @map("company_id")
  fileNumber   String         @map("file_number")
  title        String
  location     String         @default("")
  departmentId String?        @map("department_id")
  assetId      String?        @map("asset_id")
  status       FileStatus     @default(IN_REGISTRY)
  holderId     String?        @map("holder_id")
  createdAt    DateTime       @default(now()) @map("created_at")
  department   Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  asset        Asset?         @relation(fields: [assetId], references: [id], onDelete: Restrict)
  holder       Membership?    @relation("FileHolder", fields: [holderId], references: [id], onDelete: SetNull)
  movements    FileMovement[]

  @@unique([companyId, fileNumber])
  @@map("physical_files")
}

model FileMovement {
  id               String       @id @default(uuid())
  companyId        String       @map("company_id")
  fileId           String       @map("file_id")
  holderId         String       @map("holder_id")
  issuedOn         DateTime     @map("issued_on") @db.Date
  expectedReturnOn DateTime     @map("expected_return_on") @db.Date
  returnedOn       DateTime?    @map("returned_on") @db.Date
  purpose          String       @default("")
  issuedById       String       @map("issued_by_id")
  receivedById     String?      @map("received_by_id")
  createdAt        DateTime     @default(now()) @map("created_at")
  file             PhysicalFile @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([companyId, returnedOn])
  @@index([fileId])
  @@map("file_movements")
}

// ---------- Shared rate limiting (works across serverless instances) ----------

/// Sign-in locks after wrong passwords, keyed by a hash of the email address. See src/lib/login-lock-rules.ts.
model LoginGuard {
  key          String    @id
  userId       String?   @map("user_id")
  failed       Int       @default(0)
  rounds       Int       @default(0)
  lockedUntil  DateTime? @map("locked_until")
  bannedAt     DateTime? @map("banned_at")
  lastFailedAt DateTime? @map("last_failed_at")
  updatedAt    DateTime  @default(now()) @map("updated_at")

  @@index([userId])
  @@index([lockedUntil])
  @@map("login_guards")
}

model RateLimit {
  key         String   @id
  windowStart DateTime @map("window_start")
  count       Int

  @@map("rate_limits")
}

enum RenewalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NoticeParty {
  TENANT
  LANDLORD
}

enum HandoverKind {
  MOVE_IN
  MOVE_OUT
}

/// A proposed renewal. Approval by a different person creates the new lease.
model LeaseRenewal {
  id              String        @id @default(uuid())
  companyId       String        @map("company_id")
  leaseId         String        @map("lease_id")
  proposedStart   DateTime      @map("proposed_start") @db.Date
  proposedEnd     DateTime      @map("proposed_end") @db.Date
  proposedRentKobo BigInt       @map("proposed_rent_kobo")
  note            String        @default("")
  status          RenewalStatus @default(PENDING)
  requestedById   String        @map("requested_by_id")
  decidedById     String?       @map("decided_by_id")
  decidedAt       DateTime?     @map("decided_at")
  decisionNote    String        @default("") @map("decision_note")
  newLeaseId      String?       @unique @map("new_lease_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  lease           Lease         @relation(fields: [leaseId], references: [id], onDelete: Restrict)

  @@index([companyId, leaseId])
  @@map("lease_renewals")
}

/// A notice to quit, to vacate or of non-renewal. Append-only.
model LeaseNotice {
  id           String      @id @default(uuid())
  companyId    String      @map("company_id")
  leaseId      String      @map("lease_id")
  givenBy      NoticeParty @map("given_by")
  givenOn      DateTime    @map("given_on") @db.Date
  effectiveOn  DateTime    @map("effective_on") @db.Date
  reason       String
  recordedById String      @map("recorded_by_id")
  createdAt    DateTime    @default(now()) @map("created_at")
  lease        Lease       @relation(fields: [leaseId], references: [id], onDelete: Restrict)

  @@index([companyId, leaseId])
  @@map("lease_notices")
}

/// A signed-off move-in or move-out record. Append-only, one of each kind per lease.
model LeaseHandover {
  id                    String       @id @default(uuid())
  companyId             String       @map("company_id")
  leaseId               String       @map("lease_id")
  kind                  HandoverKind
  handoverOn            DateTime     @map("handover_on") @db.Date
  keysCount             Int          @map("keys_count")
  meterReadings         String       @default("") @map("meter_readings")
  conditionNotes        String       @map("condition_notes")
  issues                String       @default("")
  acknowledgedBy        String       @map("acknowledged_by")
  recordedById          String       @map("recorded_by_id")
  createdAt             DateTime     @default(now()) @map("created_at")
  lease                 Lease        @relation(fields: [leaseId], references: [id], onDelete: Restrict)

  @@unique([leaseId, kind])
  @@index([companyId])
  @@map("lease_handovers")
}

enum ServiceMethod {
  EQUAL
  FLOOR_AREA
  FIXED
}

enum ServicePeriodStatus {
  OPEN
  ASSESSED
}

/// A service charge budget for one property and period (master prompt Section 13.1).
model ServiceChargePeriod {
  id           String              @id @default(uuid())
  companyId    String              @map("company_id")
  assetId      String              @map("asset_id")
  name         String
  startDate    DateTime            @map("start_date") @db.Date
  endDate      DateTime            @map("end_date") @db.Date
  budgetKobo   BigInt              @map("budget_kobo")
  method       ServiceMethod
  status       ServicePeriodStatus @default(OPEN)
  assessedAt   DateTime?           @map("assessed_at")
  createdById  String              @map("created_by_id")
  createdAt    DateTime            @default(now()) @map("created_at")
  asset        Asset               @relation(fields: [assetId], references: [id], onDelete: Restrict)
  assessments  ServiceAssessment[]
  expenses     ServiceExpense[]

  @@index([companyId, assetId])
  @@map("service_charge_periods")
}

/// One tenant's share of a period's budget.
model ServiceAssessment {
  id         String              @id @default(uuid())
  companyId  String              @map("company_id")
  periodId   String              @map("period_id")
  leaseId    String              @map("lease_id")
  amountKobo BigInt              @map("amount_kobo")
  dueDate    DateTime            @map("due_date") @db.Date
  createdAt  DateTime            @default(now()) @map("created_at")
  period     ServiceChargePeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  lease      Lease               @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  collections ServiceCollection[]

  @@unique([periodId, leaseId])
  @@index([companyId, leaseId])
  @@map("service_assessments")
}

/// Money collected against an assessment. Append-only; a mistake is reversed, never edited.
model ServiceCollection {
  id           String            @id @default(uuid())
  companyId    String            @map("company_id")
  assessmentId String            @map("assessment_id")
  amountKobo   BigInt            @map("amount_kobo")
  paidOn       DateTime          @map("paid_on") @db.Date
  method       String            @default("")
  evidence     String
  evidenceKey  String            @map("evidence_key")
  recordedById String            @map("recorded_by_id")
  createdAt    DateTime          @default(now()) @map("created_at")
  assessment   ServiceAssessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  reversal     ServiceCollectionReversal?

  @@index([companyId, assessmentId])
  @@index([companyId, evidenceKey])
  @@map("service_collections")
}

model ServiceCollectionReversal {
  id           String            @id @default(uuid())
  companyId    String            @map("company_id")
  collectionId String            @unique @map("collection_id")
  reason       String
  reversedById String            @map("reversed_by_id")
  createdAt    DateTime          @default(now()) @map("created_at")
  collection   ServiceCollection @relation(fields: [collectionId], references: [id], onDelete: Restrict)

  @@map("service_collection_reversals")
}

/// Spending from the service charge fund. Approved by someone other than the requester.
model ServiceExpense {
  id            String              @id @default(uuid())
  companyId     String              @map("company_id")
  periodId      String              @map("period_id")
  description   String
  supplier      String              @default("")
  amountKobo    BigInt              @map("amount_kobo")
  incurredOn    DateTime            @map("incurred_on") @db.Date
  evidence      String
  status        AdjustmentStatus    @default(PENDING)
  requestedById String              @map("requested_by_id")
  decidedById   String?             @map("decided_by_id")
  decidedAt     DateTime?           @map("decided_at")
  decisionNote  String              @default("") @map("decision_note")
  createdAt     DateTime            @default(now()) @map("created_at")
  period        ServiceChargePeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)

  @@index([companyId, periodId])
  @@map("service_expenses")
}

enum ObligationKind {
  LAND_USE_CHARGE
  TENEMENT_RATE
  GROUND_RENT
  CONSENT_FEE
  STAMP_DUTY
  WITHHOLDING_TAX
  PERMIT
  INSURANCE
  OTHER
}

enum ObligationStatus {
  OPEN
  SATISFIED
  CANCELLED
}

/// A tax, levy, permit, insurance or similar duty with a deadline (master prompt Section 13.2).
/// Rates and rules are entered by the company; none are built in.
model Obligation {
  id            String           @id @default(uuid())
  companyId     String           @map("company_id")
  assetId       String?          @map("asset_id")
  kind          ObligationKind
  title         String
  authority     String           @default("")
  jurisdiction  String           @default("")
  amountKobo    BigInt?          @map("amount_kobo")
  dueDate       DateTime         @map("due_date") @db.Date
  recurrenceMonths Int?          @map("recurrence_months")
  nextReviewOn  DateTime?        @map("next_review_on") @db.Date
  requiresProfessionalReview Boolean @default(false) @map("requires_professional_review")
  reviewedBy    String           @default("") @map("reviewed_by")
  reviewedOn    DateTime?        @map("reviewed_on") @db.Date
  notes         String           @default("")
  status        ObligationStatus @default(OPEN)
  cancelReason  String           @default("") @map("cancel_reason")
  rolledFromId  String?          @unique @map("rolled_from_id")
  createdById   String           @map("created_by_id")
  createdAt     DateTime         @default(now()) @map("created_at")
  asset         Asset?           @relation(fields: [assetId], references: [id], onDelete: Restrict)
  rolledFrom    Obligation?      @relation("Rollover", fields: [rolledFromId], references: [id], onDelete: Restrict)
  rolledTo      Obligation?      @relation("Rollover")
  filing        ObligationFiling?

  @@index([companyId, status, dueDate])
  @@map("obligations")
}

/// Evidence that an obligation was met. Append-only.
model ObligationFiling {
  id             String     @id @default(uuid())
  companyId      String     @map("company_id")
  obligationId   String     @unique @map("obligation_id")
  completedOn    DateTime   @map("completed_on") @db.Date
  amountPaidKobo BigInt?    @map("amount_paid_kobo")
  evidence       String
  recordedById   String     @map("recorded_by_id")
  createdAt      DateTime   @default(now()) @map("created_at")
  obligation     Obligation @relation(fields: [obligationId], references: [id], onDelete: Restrict)

  @@map("obligation_filings")
}

// ---------- Inspections (Phase 6a) ----------

enum InspectionPurpose {
  ROUTINE
  PRE_LEASE
  MOVE_IN
  MOVE_OUT
  VALUATION
  MAINTENANCE_ASSESSMENT
  CONSTRUCTION
  CONDITION_SURVEY
}

enum InspectionStatus {
  SCHEDULED
  SUBMITTED
  APPROVED
  CANCELLED
}

enum ConditionRating {
  EXCELLENT
  GOOD
  FAIR
  POOR
  CRITICAL
}

enum CheckResult {
  PENDING
  PASS
  ATTENTION
  FAIL
  NOT_APPLICABLE
}

enum DefectSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// A reusable checklist. Starting an inspection copies its items, so later edits never change history.
model InspectionTemplate {
  id          String      @id @default(uuid())
  companyId   String      @map("company_id")
  name        String
  assetClass  AssetClass? @map("asset_class")
  active      Boolean     @default(true)
  createdById String      @map("created_by_id")
  createdAt   DateTime    @default(now()) @map("created_at")
  items       InspectionTemplateItem[]
  inspections Inspection[]

  @@unique([companyId, name])
  @@map("inspection_templates")
}

model InspectionTemplateItem {
  id         String             @id @default(uuid())
  companyId  String             @map("company_id")
  templateId String             @map("template_id")
  category   String
  prompt     String
  sortOrder  Int                @map("sort_order")
  template   InspectionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, sortOrder])
  @@map("inspection_template_items")
}

model Inspection {
  id               String            @id @default(uuid())
  companyId        String            @map("company_id")
  assetId          String            @map("asset_id")
  templateId       String?           @map("template_id")
  leaseId          String?           @map("lease_id")
  ref              String
  purpose          InspectionPurpose
  status           InspectionStatus  @default(SCHEDULED)
  scheduledFor     DateTime          @map("scheduled_for") @db.Date
  location         String            @default("")
  inspectorId      String?           @map("inspector_id")
  responsibleId    String?           @map("responsible_id")
  participants     String            @default("")
  conductedOn      DateTime?         @map("conducted_on") @db.Date
  conditionRating  ConditionRating?  @map("condition_rating")
  summary          String            @default("")
  recommendedActions String          @default("") @map("recommended_actions")
  estimatedRepairKobo BigInt?        @map("estimated_repair_kobo")
  followUpBy       DateTime?         @map("follow_up_by") @db.Date
  operatingHours   Int?              @map("operating_hours")
  technicalNotes   String            @default("") @map("technical_notes")
  recurrenceMonths Int?              @map("recurrence_months")
  rolledFromId     String?           @unique @map("rolled_from_id")
  submittedById    String?           @map("submitted_by_id")
  submittedAt      DateTime?         @map("submitted_at")
  decidedById      String?           @map("decided_by_id")
  decidedAt        DateTime?         @map("decided_at")
  returnNote       String            @default("") @map("return_note")
  cancelReason     String            @default("") @map("cancel_reason")
  createdById      String            @map("created_by_id")
  createdAt        DateTime          @default(now()) @map("created_at")
  asset            Asset             @relation(fields: [assetId], references: [id], onDelete: Restrict)
  template         InspectionTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  inspector        Membership?       @relation("InspectionInspector", fields: [inspectorId], references: [id], onDelete: SetNull)
  rolledFrom       Inspection?       @relation("InspectionRollover", fields: [rolledFromId], references: [id], onDelete: Restrict)
  rolledTo         Inspection?       @relation("InspectionRollover")
  responses        InspectionResponse[]
  findings         InspectionFinding[]

  @@unique([companyId, ref])
  @@index([companyId, status, scheduledFor])
  @@index([assetId, conductedOn])
  @@map("inspections")
}

model InspectionResponse {
  id           String      @id @default(uuid())
  companyId    String      @map("company_id")
  inspectionId String      @map("inspection_id")
  category     String
  prompt       String
  sortOrder    Int         @map("sort_order")
  result       CheckResult @default(PENDING)
  note         String      @default("")
  inspection   Inspection  @relation(fields: [inspectionId], references: [id], onDelete: Restrict)

  @@unique([inspectionId, sortOrder])
  @@map("inspection_responses")
}

model InspectionFinding {
  id             String         @id @default(uuid())
  companyId      String         @map("company_id")
  inspectionId   String         @map("inspection_id")
  title          String
  description    String         @default("")
  location       String         @default("")
  severity       DefectSeverity
  safetyRisk     Boolean        @default(false) @map("safety_risk")
  estimatedCostKobo BigInt?     @map("estimated_cost_kobo")
  recommendedAction String      @default("") @map("recommended_action")
  workOrderId    String?        @unique @map("work_order_id")
  createdById    String         @map("created_by_id")
  createdAt      DateTime       @default(now()) @map("created_at")
  inspection     Inspection     @relation(fields: [inspectionId], references: [id], onDelete: Restrict)
  workOrder      WorkOrder?     @relation(fields: [workOrderId], references: [id], onDelete: Restrict)

  @@index([companyId, inspectionId])
  @@map("inspection_findings")
}

/// A photograph attached to an inspection, finding or (later) work order. Append-only.
model EvidencePhoto {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  subjectType  String   @map("subject_type")
  subjectId    String   @map("subject_id")
  phase        String   @default("EVIDENCE")
  caption      String   @default("")
  fileName     String   @map("file_name")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  storageKey   String   @unique @map("storage_key")
  uploadedById String   @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([companyId, subjectType, subjectId])
  @@map("evidence_photos")
}

// ---------- Maintenance (Phase 6b) ----------

enum WorkOrderStatus {
  REPORTED
  TRIAGED
  APPROVED
  ASSIGNED
  IN_PROGRESS
  AWAITING_PARTS
  INSPECTION_REQUIRED
  COMPLETED
  CLOSED
  CANCELLED
}

enum WorkOrderPriority {
  LOW
  NORMAL
  HIGH
  EMERGENCY
}

enum WorkOrderSource {
  REQUEST
  INSPECTION
  PREVENTIVE
  OTHER
}

/// A vendor or tradesperson the company uses.
model Contractor {
  id          String      @id @default(uuid())
  companyId   String      @map("company_id")
  name        String
  trade       String      @default("")
  phone       String      @default("")
  email       String      @default("")
  notes       String      @default("")
  active      Boolean     @default(true)
  createdById String      @map("created_by_id")
  createdAt   DateTime    @default(now()) @map("created_at")
  workOrders  WorkOrder[]
  schedules   PreventiveSchedule[]

  @@unique([companyId, name])
  @@map("contractors")
}

model WorkOrder {
  id               String            @id @default(uuid())
  companyId        String            @map("company_id")
  assetId          String            @map("asset_id")
  ref              String
  title            String
  description      String            @default("")
  source           WorkOrderSource   @default(REQUEST)
  priority         WorkOrderPriority @default(NORMAL)
  riskLevel        DefectSeverity    @default(LOW) @map("risk_level")
  safetyRisk       Boolean           @default(false) @map("safety_risk")
  status           WorkOrderStatus   @default(REPORTED)
  requestedById    String            @map("requested_by_id")
  requesterName    String            @default("") @map("requester_name")
  leaseId          String?           @map("lease_id")
  scheduleId       String?           @map("schedule_id")
  scheduledFor     DateTime?         @map("scheduled_for") @db.Date
  assigneeId       String?           @map("assignee_id")
  contractorId     String?           @map("contractor_id")
  targetDate       DateTime?         @map("target_date") @db.Date
  estimatedCostKobo BigInt?          @map("estimated_cost_kobo")
  approvedCostKobo BigInt?           @map("approved_cost_kobo")
  approvedById     String?           @map("approved_by_id")
  approvedAt       DateTime?         @map("approved_at")
  actualCostKobo   BigInt?           @map("actual_cost_kobo")
  startedAt        DateTime?         @map("started_at")
  completedOn      DateTime?         @map("completed_on") @db.Date
  completedById    String?           @map("completed_by_id")
  completionNotes  String            @default("") @map("completion_notes")
  evidenceRef      String            @default("") @map("evidence_ref")
  verifiedById     String?           @map("verified_by_id")
  closedAt         DateTime?         @map("closed_at")
  cancelReason     String            @default("") @map("cancel_reason")
  downtimeFrom     DateTime?         @map("downtime_from") @db.Date
  downtimeTo       DateTime?         @map("downtime_to") @db.Date
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  asset            Asset             @relation(fields: [assetId], references: [id], onDelete: Restrict)
  assignee         Membership?       @relation("WorkOrderAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  contractor       Contractor?       @relation(fields: [contractorId], references: [id], onDelete: Restrict)
  schedule         PreventiveSchedule? @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  events           WorkOrderEvent[]
  materials        WorkOrderMaterial[]
  finding          InspectionFinding?

  @@unique([companyId, ref])
  @@unique([scheduleId, scheduledFor])
  @@index([companyId, status, targetDate])
  @@index([assetId])
  @@map("work_orders")
}

/// Every status change and decision on a work order. Append-only.
model WorkOrderEvent {
  id          String          @id @default(uuid())
  companyId   String          @map("company_id")
  workOrderId String          @map("work_order_id")
  kind        String
  fromStatus  WorkOrderStatus? @map("from_status")
  toStatus    WorkOrderStatus? @map("to_status")
  note        String          @default("")
  actorId     String          @map("actor_id")
  createdAt   DateTime        @default(now()) @map("created_at")
  workOrder   WorkOrder       @relation(fields: [workOrderId], references: [id], onDelete: Restrict)

  @@index([companyId, workOrderId])
  @@map("work_order_events")
}

model WorkOrderMaterial {
  id            String    @id @default(uuid())
  companyId     String    @map("company_id")
  workOrderId   String    @map("work_order_id")
  description   String
  quantity      Int
  unit          String    @default("")
  unitCostKobo  BigInt    @map("unit_cost_kobo")
  recordedById  String    @map("recorded_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  inventoryItemId String?  @map("inventory_item_id")
  workOrder     WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)

  @@index([companyId, workOrderId])
  @@map("work_order_materials")
}

/// A recurring maintenance job. Work orders are created ahead of each due date.
model PreventiveSchedule {
  id               String            @id @default(uuid())
  companyId        String            @map("company_id")
  assetId          String            @map("asset_id")
  title            String
  description      String            @default("")
  priority         WorkOrderPriority @default(NORMAL)
  intervalMonths   Int               @map("interval_months")
  nextDueOn        DateTime          @map("next_due_on") @db.Date
  leadDays         Int               @default(14) @map("lead_days")
  contractorId     String?           @map("contractor_id")
  assigneeId       String?           @map("assignee_id")
  estimatedCostKobo BigInt?          @map("estimated_cost_kobo")
  active           Boolean           @default(true)
  createdById      String            @map("created_by_id")
  createdAt        DateTime          @default(now()) @map("created_at")
  asset            Asset             @relation(fields: [assetId], references: [id], onDelete: Restrict)
  contractor       Contractor?       @relation(fields: [contractorId], references: [id], onDelete: Restrict)
  assignee         Membership?       @relation("ScheduleAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  workOrders       WorkOrder[]

  @@index([companyId, active, nextDueOn])
  @@map("preventive_schedules")
}

// ---------- Inventory (Phase 6c) ----------

enum InventoryKind {
  FIXED_ASSET
  MOVABLE
  CONSUMABLE
}

enum InventoryItemStatus {
  ACTIVE
  DISPOSED
}

enum MovementKind {
  RECEIPT
  ISSUE
  TRANSFER
  RETURN
  CONSUMPTION
  ADJUSTMENT
  LOSS
  DAMAGE
  DISPOSAL
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CountStatus {
  OPEN
  SUBMITTED
  APPROVED
  CANCELLED
}

enum ScheduleStatus {
  DRAFT
  ACKNOWLEDGED
}

/// A register entry for contents, equipment, tools or consumable stock. The balance is changed only by movements.
model InventoryItem {
  id            String              @id @default(uuid())
  companyId     String              @map("company_id")
  itemNo        String              @map("item_no")
  code          String
  name          String
  category      String              @default("")
  kind          InventoryKind
  assetId       String?             @map("asset_id")
  serialNumber  String              @default("") @map("serial_number")
  model         String              @default("")
  manufacturer  String              @default("")
  unit          String              @default("pcs")
  quantity      Int                 @default(0)
  condition     ConditionRating     @default(GOOD)
  location      String              @default("")
  custodianId   String?             @map("custodian_id")
  acquiredOn    DateTime?           @map("acquired_on") @db.Date
  unitCostKobo  BigInt?             @map("unit_cost_kobo")
  ownership     String              @default("Owned")
  warrantyUntil DateTime?           @map("warranty_until") @db.Date
  reorderLevel  Int?                @map("reorder_level")
  lastVerifiedOn DateTime?          @map("last_verified_on") @db.Date
  status        InventoryItemStatus @default(ACTIVE)
  notes         String              @default("")
  createdById   String              @map("created_by_id")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  asset         Asset?              @relation(fields: [assetId], references: [id], onDelete: Restrict)
  custodian     Membership?         @relation("ItemCustodian", fields: [custodianId], references: [id], onDelete: SetNull)
  movements     InventoryMovement[]
  adjustments   InventoryAdjustment[]
  countLines    InventoryCountLine[]
  projectUses   ProjectStockUse[]

  @@unique([companyId, itemNo])
  @@unique([companyId, code])
  @@index([companyId, assetId])
  @@map("inventory_items")
}

/// Every change to a balance, location or custody. Append-only. `delta` is signed; a transfer has delta 0.
model InventoryMovement {
  id            String        @id @default(uuid())
  companyId     String        @map("company_id")
  itemId        String        @map("item_id")
  kind          MovementKind
  delta         Int
  balanceAfter  Int           @map("balance_after")
  fromLocation  String        @default("") @map("from_location")
  toLocation    String        @default("") @map("to_location")
  workOrderId   String?       @map("work_order_id")
  reference     String        @default("")
  note          String        @default("")
  performedById String        @map("performed_by_id")
  approvedById  String?       @map("approved_by_id")
  adjustmentId  String?       @map("adjustment_id")
  countId       String?       @map("count_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  item          InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([companyId, itemId, createdAt])
  @@index([workOrderId])
  @@map("inventory_movements")
}

/// A request to correct, write off or dispose of stock. Another person approves it before the balance changes.
model InventoryAdjustment {
  id            String        @id @default(uuid())
  companyId     String        @map("company_id")
  itemId        String        @map("item_id")
  kind          MovementKind
  delta         Int
  reason        String
  status        RequestStatus @default(PENDING)
  requestedById String        @map("requested_by_id")
  decidedById   String?       @map("decided_by_id")
  decidedAt     DateTime?     @map("decided_at")
  decisionNote  String        @default("") @map("decision_note")
  createdAt     DateTime      @default(now()) @map("created_at")
  item          InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([companyId, status])
  @@map("inventory_adjustments")
}

/// A physical count (stocktake). Lines hold the expected balance when the count started and what was counted.
model InventoryCount {
  id            String       @id @default(uuid())
  companyId     String       @map("company_id")
  ref           String
  title         String
  assetId       String?      @map("asset_id")
  status        CountStatus  @default(OPEN)
  startedById   String       @map("started_by_id")
  submittedById String?      @map("submitted_by_id")
  decidedById   String?      @map("decided_by_id")
  decidedAt     DateTime?    @map("decided_at")
  decisionNote  String       @default("") @map("decision_note")
  createdAt     DateTime     @default(now()) @map("created_at")
  lines         InventoryCountLine[]

  @@unique([companyId, ref])
  @@index([companyId, status])
  @@map("inventory_counts")
}

model InventoryCountLine {
  id           String         @id @default(uuid())
  companyId    String         @map("company_id")
  countId      String         @map("count_id")
  itemId       String         @map("item_id")
  expectedQty  Int            @map("expected_qty")
  countedQty   Int?           @map("counted_qty")
  note         String         @default("")
  countedById  String?        @map("counted_by_id")
  count        InventoryCount @relation(fields: [countId], references: [id], onDelete: Restrict)
  item         InventoryItem  @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([countId, itemId])
  @@index([companyId, countId])
  @@map("inventory_count_lines")
}

/// A room-by-room inventory schedule for a lease at move-in or move-out, acknowledged by the occupant.
model HandoverSchedule {
  id             String         @id @default(uuid())
  companyId      String         @map("company_id")
  leaseId        String         @map("lease_id")
  kind           HandoverKind
  status         ScheduleStatus @default(DRAFT)
  acknowledgedBy String         @default("") @map("acknowledged_by")
  acknowledgedOn DateTime?      @map("acknowledged_on") @db.Date
  recordedById   String         @map("recorded_by_id")
  createdAt      DateTime       @default(now()) @map("created_at")
  lease          Lease          @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  lines          HandoverScheduleLine[]

  @@unique([leaseId, kind])
  @@index([companyId])
  @@map("handover_schedules")
}

model HandoverScheduleLine {
  id          String           @id @default(uuid())
  companyId   String           @map("company_id")
  scheduleId  String           @map("schedule_id")
  room        String
  description String
  quantity    Int
  condition   ConditionRating
  notes       String           @default("")
  sortOrder   Int              @default(0) @map("sort_order")
  schedule    HandoverSchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)

  @@index([companyId, scheduleId])
  @@map("handover_schedule_lines")
}

// ---------- Phase 7a: valuation ----------

enum ValuationPurpose {
  SALE
  PURCHASE
  MORTGAGE_SECURITY
  INSURANCE
  FINANCIAL_REPORTING
  TAXATION
  LITIGATION
  OTHER
}

enum ValuationBasis {
  MARKET_VALUE
  MARKET_RENT
  REINSTATEMENT_COST
  FORCED_SALE_VALUE
  OTHER
}

enum ValuationPremise {
  STANDARD
  GOING_CONCERN
  GONE_CONCERN
}

enum ValuationStatus {
  INSTRUCTED
  IN_PROGRESS
  IN_REVIEW
  APPROVED
  ISSUED
  CANCELLED
}

enum ValuationMethod {
  SALES_COMPARISON
  INCOME_CAPITALISATION
  COST_APPROACH
}

enum EvidenceKind {
  SALE
  LETTING
  LISTING
  OFFER
  OTHER
}

enum EntryKind {
  PREMISE
  ASSUMPTION
  SPECIAL_ASSUMPTION
  LIMITATION
}

enum ReportStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  SUPERSEDED
}

/// A valuation assignment: what is being valued, why, as at when, on what basis and premise, and by whom.
model ValuationInstruction {
  id               String            @id @default(uuid())
  companyId        String            @map("company_id")
  ref              String
  assetId          String            @map("asset_id")
  clientName       String            @map("client_name")
  clientReference  String            @default("") @map("client_reference")
  purpose          ValuationPurpose
  purposeNote      String            @default("") @map("purpose_note")
  basis            ValuationBasis    @default(MARKET_VALUE)
  premise          ValuationPremise  @default(STANDARD)
  assetDescription String            @default("") @map("asset_description")
  scope            String            @default("")
  instructionDate  DateTime          @map("instruction_date") @db.Date
  valuationDate    DateTime?         @map("valuation_date") @db.Date
  inspectionDate   DateTime?         @map("inspection_date") @db.Date
  dueDate          DateTime?         @map("due_date") @db.Date
  status           ValuationStatus   @default(INSTRUCTED)
  assignedToId     String?           @map("assigned_to_id")
  professionalName String            @default("") @map("professional_name")
  professionalBody String            @default("") @map("professional_body")
  registrationNo   String            @default("") @map("registration_no")
  issuedOn         DateTime?         @map("issued_on") @db.Date
  createdById      String            @map("created_by_id")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  asset            Asset             @relation(fields: [assetId], references: [id], onDelete: Restrict)
  worksheets       ValuationWorksheet[]
  comparables      ValuationComparable[]
  entries          ValuationEntry[]
  documents        ValuationDocument[]
  reports          ValuationReport[]

  @@unique([companyId, ref])
  @@index([companyId, status])
  @@index([companyId, assetId])
  @@map("valuation_instructions")
}

/// One valuation method applied to an instruction, with its inputs and the calculated result.
model ValuationWorksheet {
  id            String               @id @default(uuid())
  companyId     String               @map("company_id")
  instructionId String               @map("instruction_id")
  method        ValuationMethod
  inputs        Json                 @default("{}")
  resultKobo    BigInt?              @map("result_kobo")
  lines         Json                 @default("[]")
  warnings      Json                 @default("[]")
  note          String               @default("")
  calculatedAt  DateTime?            @map("calculated_at")
  createdById   String               @map("created_by_id")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")
  instruction   ValuationInstruction @relation(fields: [instructionId], references: [id], onDelete: Cascade)

  @@unique([instructionId, method])
  @@index([companyId])
  @@map("valuation_worksheets")
}

/// Market evidence: a sale, letting, listing or offer, with the adjustment and weight the professional applies.
model ValuationComparable {
  id             String               @id @default(uuid())
  companyId      String               @map("company_id")
  instructionId  String               @map("instruction_id")
  kind           EvidenceKind         @default(SALE)
  address        String
  evidenceDate   DateTime             @map("evidence_date") @db.Date
  priceKobo      BigInt               @map("price_kobo")
  areaSqm100     Int                  @map("area_sqm100")
  adjustmentBps  Int                  @default(0) @map("adjustment_bps")
  adjustmentNote String               @default("") @map("adjustment_note")
  weightBps      Int                  @default(10000) @map("weight_bps")
  source         String               @default("")
  verifiedById   String?              @map("verified_by_id")
  verifiedAt     DateTime?            @map("verified_at")
  createdById    String               @map("created_by_id")
  createdAt      DateTime             @default(now()) @map("created_at")
  instruction    ValuationInstruction @relation(fields: [instructionId], references: [id], onDelete: Cascade)

  @@index([companyId, instructionId])
  @@map("valuation_comparables")
}

/// Premises, assumptions, special assumptions and limitations recorded for the valuation.
model ValuationEntry {
  id            String               @id @default(uuid())
  companyId     String               @map("company_id")
  instructionId String               @map("instruction_id")
  kind          EntryKind
  text          String
  createdById   String               @map("created_by_id")
  createdAt     DateTime             @default(now()) @map("created_at")
  instruction   ValuationInstruction @relation(fields: [instructionId], references: [id], onDelete: Cascade)

  @@index([companyId, instructionId])
  @@map("valuation_entries")
}

/// Supporting documents (title deeds, survey plans, evidence extracts). Contents live in stored_files.
model ValuationDocument {
  id            String               @id @default(uuid())
  companyId     String               @map("company_id")
  instructionId String               @map("instruction_id")
  title         String
  fileName      String               @map("file_name")
  mimeType      String               @map("mime_type")
  sizeBytes     Int                  @map("size_bytes")
  storageKey    String               @unique @map("storage_key")
  uploadedById  String               @map("uploaded_by_id")
  createdAt     DateTime             @default(now()) @map("created_at")
  instruction   ValuationInstruction @relation(fields: [instructionId], references: [id], onDelete: Cascade)

  @@index([companyId, instructionId])
  @@map("valuation_documents")
}

/// A draft or approved report. When submitted, a snapshot of the worksheets and evidence is frozen with it.
/// An approved report cannot change. A revision is a new version.
model ValuationReport {
  id                  String               @id @default(uuid())
  companyId           String               @map("company_id")
  instructionId       String               @map("instruction_id")
  version             Int
  status              ReportStatus         @default(DRAFT)
  summary             String               @default("")
  conclusion          String               @default("")
  concludedValueKobo  BigInt?              @map("concluded_value_kobo")
  reconciliationNote  String               @default("") @map("reconciliation_note")
  aiAssisted          Boolean              @default(false) @map("ai_assisted")
  aiNote              String               @default("") @map("ai_note")
  snapshot            Json?
  authorId            String               @map("author_id")
  submittedAt         DateTime?            @map("submitted_at")
  decidedById         String?              @map("decided_by_id")
  decidedAt           DateTime?            @map("decided_at")
  decisionNote        String               @default("") @map("decision_note")
  reviewConfirmed     Boolean              @default(false) @map("review_confirmed")
  supersededAt        DateTime?            @map("superseded_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  instruction         ValuationInstruction @relation(fields: [instructionId], references: [id], onDelete: Restrict)

  @@unique([instructionId, version])
  @@index([companyId, status])
  @@map("valuation_reports")
}

// ---------- Phase 7b: construction and renovation projects ----------

enum ProjectKind {
  CONSTRUCTION
  RENOVATION
  FIT_OUT
  REPAIR_PROGRAMME
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum BudgetStatus {
  DRAFT
  SUBMITTED
  APPROVED
}

enum WorkStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
  BLOCKED
}

enum InvoiceStatus {
  RECEIVED
  APPROVED
  REJECTED
  PAID
}

enum VariationTarget {
  COMMITMENT
  BUDGET
}

/// A construction, renovation or repair project on an asset.
model Project {
  id                  String        @id @default(uuid())
  companyId           String        @map("company_id")
  ref                 String
  assetId             String        @map("asset_id")
  title               String
  kind                ProjectKind
  description         String        @default("")
  status              ProjectStatus @default(PLANNING)
  managerId           String?       @map("manager_id")
  plannedStart        DateTime      @map("planned_start") @db.Date
  plannedEnd          DateTime      @map("planned_end") @db.Date
  actualStart         DateTime?     @map("actual_start") @db.Date
  actualEnd           DateTime?     @map("actual_end") @db.Date
  contingencyKobo     BigInt        @default(0) @map("contingency_kobo")
  budgetStatus        BudgetStatus  @default(DRAFT) @map("budget_status")
  budgetSubmittedById String?       @map("budget_submitted_by_id")
  budgetDecidedById   String?       @map("budget_decided_by_id")
  budgetDecidedAt     DateTime?     @map("budget_decided_at")
  budgetNote          String        @default("") @map("budget_note")
  approvedBudgetKobo  BigInt?       @map("approved_budget_kobo")
  holdReason          String        @default("") @map("hold_reason")
  cancelReason        String        @default("") @map("cancel_reason")
  completionRequestedById String?   @map("completion_requested_by_id")
  completionRequestedAt   DateTime? @map("completion_requested_at")
  completionNote      String        @default("") @map("completion_note")
  defectsMonths       Int           @default(12) @map("defects_months")
  completedById       String?       @map("completed_by_id")
  completedAt         DateTime?     @map("completed_at")
  defectsPeriodEnd    DateTime?     @map("defects_period_end") @db.Date
  handoverOn          DateTime?     @map("handover_on") @db.Date
  handoverById        String?       @map("handover_by_id")
  handedToName        String        @default("") @map("handed_to_name")
  handoverNote        String        @default("") @map("handover_note")
  createdById         String        @map("created_by_id")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  asset               Asset         @relation(fields: [assetId], references: [id], onDelete: Restrict)
  defects             ProjectDefect[]
  warranties          ProjectWarranty[]
  documents           ProjectDocument[]
  handoverItems       HandoverItem[]
  workPackages        WorkPackage[]
  milestones          Milestone[]
  commitments         Commitment[]
  invoices            ProjectInvoice[]
  variations          Variation[]
  forecasts           ProjectForecast[]
  parties             ProjectParty[]
  procurement         ProcurementItem[]
  stockUses           ProjectStockUse[]
  risks               ProjectRisk[]
  siteInspections     SiteInspection[]
  progressUpdates     ProgressUpdate[]
  qualityChecks       QualityCheck[]

  @@unique([companyId, ref])
  @@index([companyId, status])
  @@index([companyId, assetId])
  @@map("projects")
}

model WorkPackage {
  id              String     @id @default(uuid())
  companyId       String     @map("company_id")
  projectId       String     @map("project_id")
  code            String
  title           String
  description     String     @default("")
  responsibleId   String?    @map("responsible_id")
  contractorId    String?    @map("contractor_id")
  plannedStart    DateTime   @map("planned_start") @db.Date
  plannedEnd      DateTime   @map("planned_end") @db.Date
  actualStart     DateTime?  @map("actual_start") @db.Date
  actualEnd       DateTime?  @map("actual_end") @db.Date
  percentComplete Int        @default(0) @map("percent_complete")
  status          WorkStatus @default(NOT_STARTED)
  budgetKobo      BigInt     @default(0) @map("budget_kobo")
  sortOrder       Int        @default(0) @map("sort_order")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  project         Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestones      Milestone[]
  commitments     Commitment[]
  forecasts       ProjectForecast[]
  procurement     ProcurementItem[]
  qualityChecks   QualityCheck[]

  @@unique([projectId, code])
  @@index([companyId, projectId])
  @@map("work_packages")
}

model Milestone {
  id            String       @id @default(uuid())
  companyId     String       @map("company_id")
  projectId     String       @map("project_id")
  workPackageId String?      @map("work_package_id")
  title         String
  dueOn         DateTime     @map("due_on") @db.Date
  achievedOn    DateTime?    @map("achieved_on") @db.Date
  achievedById  String?      @map("achieved_by_id")
  note          String       @default("")
  createdAt     DateTime     @default(now()) @map("created_at")
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workPackage   WorkPackage? @relation(fields: [workPackageId], references: [id], onDelete: SetNull)

  @@index([companyId, projectId])
  @@map("milestones")
}

/// Money the company has committed to spend: a contract or purchase order, approved by a second person.
model Commitment {
  id            String        @id @default(uuid())
  companyId     String        @map("company_id")
  projectId     String        @map("project_id")
  workPackageId String?       @map("work_package_id")
  ref           String
  supplierName  String        @map("supplier_name")
  contractorId  String?       @map("contractor_id")
  description   String
  amountKobo    BigInt        @map("amount_kobo")
  status        RequestStatus @default(PENDING)
  requestedById String        @map("requested_by_id")
  decidedById   String?       @map("decided_by_id")
  decidedAt     DateTime?     @map("decided_at")
  decisionNote  String        @default("") @map("decision_note")
  createdAt     DateTime      @default(now()) @map("created_at")
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workPackage   WorkPackage?  @relation(fields: [workPackageId], references: [id], onDelete: SetNull)
  invoices      ProjectInvoice[]
  variations    Variation[]

  @@unique([companyId, ref])
  @@index([companyId, projectId])
  @@map("commitments")
}

model ProjectInvoice {
  id            String        @id @default(uuid())
  companyId     String        @map("company_id")
  projectId     String        @map("project_id")
  commitmentId  String        @map("commitment_id")
  invoiceNo     String        @map("invoice_no")
  invoiceDate   DateTime      @map("invoice_date") @db.Date
  dueDate       DateTime?     @map("due_date") @db.Date
  amountKobo    BigInt        @map("amount_kobo")
  status        InvoiceStatus @default(RECEIVED)
  recordedById  String        @map("recorded_by_id")
  decidedById   String?       @map("decided_by_id")
  decidedAt     DateTime?     @map("decided_at")
  decisionNote  String        @default("") @map("decision_note")
  paidOn        DateTime?     @map("paid_on") @db.Date
  paidById      String?       @map("paid_by_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  commitment    Commitment    @relation(fields: [commitmentId], references: [id], onDelete: Restrict)

  @@unique([commitmentId, invoiceNo])
  @@index([companyId, projectId])
  @@map("project_invoices")
}

/// A change to a contract sum or to the approved budget, with any time it adds. Approved by a second person.
model Variation {
  id            String          @id @default(uuid())
  companyId     String          @map("company_id")
  projectId     String          @map("project_id")
  ref           String
  target        VariationTarget
  commitmentId  String?         @map("commitment_id")
  workPackageId String?         @map("work_package_id")
  title         String
  reason        String
  amountKobo    BigInt          @map("amount_kobo")
  timeImpactDays Int            @default(0) @map("time_impact_days")
  status        RequestStatus   @default(PENDING)
  requestedById String          @map("requested_by_id")
  decidedById   String?         @map("decided_by_id")
  decidedAt     DateTime?       @map("decided_at")
  decisionNote  String          @default("") @map("decision_note")
  createdAt     DateTime        @default(now()) @map("created_at")
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  commitment    Commitment?     @relation(fields: [commitmentId], references: [id], onDelete: Restrict)

  @@unique([companyId, ref])
  @@index([companyId, projectId])
  @@map("variations")
}

/// Estimate to complete for a work package. Each entry is a dated estimate; the latest one is current.
model ProjectForecast {
  id            String      @id @default(uuid())
  companyId     String      @map("company_id")
  projectId     String      @map("project_id")
  workPackageId String      @map("work_package_id")
  etcKobo       BigInt      @map("etc_kobo")
  note          String      @default("")
  recordedById  String      @map("recorded_by_id")
  createdAt     DateTime    @default(now()) @map("created_at")
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workPackage   WorkPackage @relation(fields: [workPackageId], references: [id], onDelete: Cascade)

  @@index([companyId, projectId, workPackageId, createdAt], map: "project_forecasts_lookup_idx")
  @@map("project_forecasts")
}

// ---------- Phase 7c-1: project delivery ----------

enum PartyRole {
  CONTRACTOR
  CONSULTANT
  SUPPLIER
  OTHER
}

enum ProcurementStatus {
  REQUIRED
  ORDERED
  DELIVERED
  CANCELLED
}

enum RiskStatus {
  OPEN
  MITIGATING
  CLOSED
  OCCURRED
}

enum SiteOutcome {
  SATISFACTORY
  ACTIONS_REQUIRED
  FAILED
}

enum QualityResult {
  PENDING
  PASSED
  FAILED
  WAIVED
}

/// A contractor, consultant or supplier appointed to the project.
model ProjectParty {
  id           String    @id @default(uuid())
  companyId    String    @map("company_id")
  projectId    String    @map("project_id")
  role         PartyRole
  contractorId String?   @map("contractor_id")
  name         String
  scope        String    @default("")
  email        String    @default("")
  phone        String    @default("")
  appointedOn  DateTime? @map("appointed_on") @db.Date
  endedOn      DateTime? @map("ended_on") @db.Date
  createdById  String    @map("created_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, role, name])
  @@index([companyId, projectId])
  @@map("project_parties")
}

/// A material or service the project needs, tracked from requirement through order to delivery.
model ProcurementItem {
  id              String            @id @default(uuid())
  companyId       String            @map("company_id")
  projectId       String            @map("project_id")
  workPackageId   String?           @map("work_package_id")
  description     String
  quantity        Int
  unit            String            @default("pcs")
  requiredBy      DateTime          @map("required_by") @db.Date
  status          ProcurementStatus @default(REQUIRED)
  supplierName    String            @default("") @map("supplier_name")
  commitmentId    String?           @map("commitment_id")
  orderedOn       DateTime?         @map("ordered_on") @db.Date
  deliveredOn     DateTime?         @map("delivered_on") @db.Date
  deliveredQty    Int               @default(0) @map("delivered_qty")
  inventoryItemId String?           @map("inventory_item_id")
  note            String            @default("")
  createdById     String            @map("created_by_id")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workPackage     WorkPackage?      @relation(fields: [workPackageId], references: [id], onDelete: SetNull)

  @@index([companyId, projectId])
  @@map("procurement_items")
}

/// Stock taken from the inventory register for the project. Append-only, like the movement it records.
model ProjectStockUse {
  id            String        @id @default(uuid())
  companyId     String        @map("company_id")
  projectId     String        @map("project_id")
  workPackageId String?       @map("work_package_id")
  itemId        String        @map("item_id")
  quantity      Int
  unitCostKobo  BigInt        @default(0) @map("unit_cost_kobo")
  movementId    String        @map("movement_id")
  recordedById  String        @map("recorded_by_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  item          InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([companyId, projectId])
  @@map("project_stock_uses")
}

model ProjectRisk {
  id          String     @id @default(uuid())
  companyId   String     @map("company_id")
  projectId   String     @map("project_id")
  ref         String
  title       String
  description String     @default("")
  category    String     @default("")
  likelihood  Int
  impact      Int
  ownerId     String?    @map("owner_id")
  mitigation  String     @default("")
  status      RiskStatus @default(OPEN)
  reviewOn    DateTime?  @map("review_on") @db.Date
  closeNote   String     @default("") @map("close_note")
  closedAt    DateTime?  @map("closed_at")
  createdById String     @map("created_by_id")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, ref])
  @@index([companyId, projectId])
  @@map("project_risks")
}

/// A site visit. Recorded once and never edited, with photographs as evidence.
model SiteInspection {
  id            String      @id @default(uuid())
  companyId     String      @map("company_id")
  projectId     String      @map("project_id")
  workPackageId String?     @map("work_package_id")
  inspectedOn   DateTime    @map("inspected_on") @db.Date
  inspectorId   String      @map("inspector_id")
  summary       String
  actions       String      @default("")
  outcome       SiteOutcome
  createdAt     DateTime    @default(now()) @map("created_at")
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([companyId, projectId, inspectedOn])
  @@map("site_inspections")
}

/// A dated progress report. Recorded once and never edited.
model ProgressUpdate {
  id              String   @id @default(uuid())
  companyId       String   @map("company_id")
  projectId       String   @map("project_id")
  reportDate      DateTime @map("report_date") @db.Date
  summary         String
  issues          String   @default("")
  nextSteps       String   @default("") @map("next_steps")
  percentComplete Int      @map("percent_complete")
  recordedById    String   @map("recorded_by_id")
  createdAt       DateTime @default(now()) @map("created_at")
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([companyId, projectId, reportDate])
  @@map("progress_updates")
}

/// A quality check on a work package. Someone other than the person responsible for the work passes it.
model QualityCheck {
  id            String        @id @default(uuid())
  companyId     String        @map("company_id")
  projectId     String        @map("project_id")
  workPackageId String        @map("work_package_id")
  title         String
  standard      String        @default("")
  result        QualityResult @default(PENDING)
  checkedById   String?       @map("checked_by_id")
  checkedOn     DateTime?     @map("checked_on") @db.Date
  note          String        @default("")
  createdById   String        @map("created_by_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workPackage   WorkPackage   @relation(fields: [workPackageId], references: [id], onDelete: Cascade)

  @@index([companyId, projectId, workPackageId])
  @@map("quality_checks")
}

enum DefectStatus {
  OPEN
  FIXED
  VERIFIED
}

enum ProjectDocKind {
  DRAWING
  CERTIFICATE
  WARRANTY
  MANUAL
  HANDOVER
  OTHER
}

/// A snag or defect found at completion or during the defects liability period. The person who fixes it
/// is never the person who verifies the fix.
model ProjectDefect {
  id            String         @id @default(uuid())
  companyId     String         @map("company_id")
  projectId     String         @map("project_id")
  workPackageId String?        @map("work_package_id")
  ref           String
  title         String
  description   String         @default("")
  severity      DefectSeverity
  status        DefectStatus   @default(OPEN)
  raisedById    String         @map("raised_by_id")
  raisedOn      DateTime       @map("raised_on") @db.Date
  dueOn         DateTime?      @map("due_on") @db.Date
  fixedById     String?        @map("fixed_by_id")
  fixedOn       DateTime?      @map("fixed_on") @db.Date
  fixNote       String         @default("") @map("fix_note")
  verifiedById  String?        @map("verified_by_id")
  verifiedOn    DateTime?      @map("verified_on") @db.Date
  verifyNote    String         @default("") @map("verify_note")
  workOrderId   String?        @map("work_order_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([companyId, projectId, ref])
  @@index([companyId, projectId, status])
  @@map("project_defects")
}

/// A warranty or guarantee that came with the works, linked to the asset so maintenance can see it.
model ProjectWarranty {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  projectId   String   @map("project_id")
  assetId     String   @map("asset_id")
  title       String
  provider    String
  coverage    String   @default("")
  startsOn    DateTime @map("starts_on") @db.Date
  endsOn      DateTime @map("ends_on") @db.Date
  documentId  String?  @map("document_id")
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([companyId, assetId, endsOn])
  @@index([companyId, projectId])
  @@map("project_warranties")
}

/// A file kept with the project: drawings, certificates, manuals and handover papers. Never changed once added.
model ProjectDocument {
  id           String         @id @default(uuid())
  companyId    String         @map("company_id")
  projectId    String         @map("project_id")
  kind         ProjectDocKind
  title        String
  fileName     String         @map("file_name")
  mimeType     String         @map("mime_type")
  sizeBytes    Int            @map("size_bytes")
  storageKey   String         @unique @map("storage_key")
  uploadedById String         @map("uploaded_by_id")
  createdAt    DateTime       @default(now()) @map("created_at")
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([companyId, projectId])
  @@map("project_documents")
}

/// One line of the handover checklist, created when the project is completed.
model HandoverItem {
  id         String    @id @default(uuid())
  companyId  String    @map("company_id")
  projectId  String    @map("project_id")
  title      String
  sortOrder  Int       @default(0) @map("sort_order")
  done       Boolean   @default(false)
  doneById   String?   @map("done_by_id")
  doneOn     DateTime? @map("done_on") @db.Date
  note       String    @default("")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([companyId, projectId, sortOrder])
  @@map("handover_items")
}

// ---------- CRM (Phase 8) ----------

enum ClientKind {
  INDIVIDUAL
  ORGANISATION
}

enum SalesLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

enum ActivityKind {
  NOTE
  CALL
  EMAIL
  MEETING
  WHATSAPP
  FOLLOW_UP
}

enum Timeline {
  UNKNOWN
  IMMEDIATE
  WITHIN_3_MONTHS
  WITHIN_6_MONTHS
  LATER
}

enum Financing {
  UNKNOWN
  CASH
  MORTGAGE_APPROVED
  MORTGAGE_PENDING
}

enum MatchStatus {
  SUGGESTED
  SENT
  INTERESTED
  REJECTED
}

/// A branch office of the company.
model Branch {
  id        String       @id @default(uuid())
  companyId String       @map("company_id")
  name      String
  code      String
  createdAt DateTime     @default(now()) @map("created_at")
  members   Membership[]
  teams     Team[]

  @@unique([companyId, code])
  @@map("branches")
}

/// A sales team inside a branch. A team lead can see the work of their team.
model Team {
  id        String       @id @default(uuid())
  companyId String       @map("company_id")
  branchId  String?      @map("branch_id")
  name      String
  leadId    String?      @map("lead_id")
  createdAt DateTime     @default(now()) @map("created_at")
  branch    Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  members   Membership[] @relation("TeamMembers")

  @@unique([companyId, name])
  @@map("teams")
}

/// A person or organisation the company deals with. Contact details are kept in a normal form so duplicates can be found.
model Client {
  id               String       @id @default(uuid())
  companyId        String       @map("company_id")
  ref              String
  kind             ClientKind   @default(INDIVIDUAL)
  name             String
  email            String       @default("")
  emailNorm        String       @default("") @map("email_norm")
  phone            String       @default("")
  phoneNorm        String       @default("") @map("phone_norm")
  address          String       @default("")
  city             String       @default("")
  notes            String       @default("")
  ownerId          String       @map("owner_id")
  confidential     Boolean      @default(false)
  marketingConsent Boolean      @default(false) @map("marketing_consent")
  archivedAt       DateTime?    @map("archived_at")
  mergedIntoId     String?      @map("merged_into_id")
  createdById      String       @map("created_by_id")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  leads            Lead[]
  activities       ClientActivity[]
  requirements     PropertyRequirement[]

  @@unique([companyId, ref])
  @@index([companyId, ownerId])
  @@index([companyId, emailNorm])
  @@index([companyId, phoneNorm])
  @@map("clients")
  deals            Deal[]
}

/// Two client records a person has looked at and decided are not the same.
model ClientNotDuplicate {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  clientAId   String   @map("client_a_id")
  clientBId   String   @map("client_b_id")
  decidedById String   @map("decided_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([companyId, clientAId, clientBId])
  @@map("client_not_duplicates")
}

model LeadSource {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  leads     Lead[]

  @@unique([companyId, name])
  @@map("lead_sources")
}

model Lead {
  id               String     @id @default(uuid())
  companyId        String     @map("company_id")
  ref              String
  clientId         String     @map("client_id")
  sourceId         String?    @map("source_id")
  sourceEnquiryId  String?    @unique @map("source_enquiry_id")
  listingId        String?    @map("listing_id")
  title            String
  status           SalesLeadStatus @default(NEW)
  ownerId          String     @map("owner_id")
  assignedById     String?    @map("assigned_by_id")
  assignedAt       DateTime?  @map("assigned_at")
  budgetMaxKobo    BigInt?    @map("budget_max_kobo")
  timeline         Timeline   @default(UNKNOWN)
  financing        Financing  @default(UNKNOWN)
  decisionMaker    Boolean    @default(false) @map("decision_maker")
  score            Int        @default(0)
  qualifiedById    String?    @map("qualified_by_id")
  qualifiedAt      DateTime?  @map("qualified_at")
  lostReason       String     @default("") @map("lost_reason")
  convertedAt      DateTime?  @map("converted_at")
  createdById      String     @map("created_by_id")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  client           Client     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  source           LeadSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  activities       ClientActivity[]

  @@unique([companyId, ref])
  @@index([companyId, status])
  @@index([companyId, ownerId])
  @@index([companyId, clientId])
  @@map("leads")
}

/// A note, call, meeting, message or follow-up on a client. Follow-ups have a due date and are ticked off when done.
model ClientActivity {
  id          String       @id @default(uuid())
  companyId   String       @map("company_id")
  clientId    String       @map("client_id")
  leadId      String?      @map("lead_id")
  kind        ActivityKind
  subject     String
  body        String       @default("")
  occurredAt  DateTime     @default(now()) @map("occurred_at")
  dueOn       DateTime?    @map("due_on") @db.Date
  assigneeId  String?      @map("assignee_id")
  doneAt      DateTime?    @map("done_at")
  doneById    String?      @map("done_by_id")
  system      Boolean      @default(false)
  createdById String       @map("created_by_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  dealId      String?      @map("deal_id")
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([companyId, clientId, occurredAt])
  @@index([companyId, kind, dueOn])
  @@index([companyId, dealId])
  @@map("client_activities")
}

/// What a client is looking for. Published listings are matched against it.
model PropertyRequirement {
  id           String         @id @default(uuid())
  companyId    String         @map("company_id")
  clientId     String         @map("client_id")
  leadId       String?        @map("lead_id")
  purpose      ListingPurpose
  assetClass   String         @default("") @map("asset_class")
  city         String         @default("")
  state        String         @default("")
  bedroomsMin  Int?           @map("bedrooms_min")
  budgetMinKobo BigInt?       @map("budget_min_kobo")
  budgetMaxKobo BigInt        @map("budget_max_kobo")
  notes        String         @default("")
  active       Boolean        @default(true)
  createdById  String         @map("created_by_id")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  client       Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  matches      RequirementMatch[]

  @@index([companyId, clientId])
  @@index([companyId, active, purpose])
  @@map("property_requirements")
}

/// Where a suggested listing stands for a requirement: suggested, sent to the client, or the client's response.
model RequirementMatch {
  id            String              @id @default(uuid())
  companyId     String              @map("company_id")
  requirementId String              @map("requirement_id")
  listingId     String              @map("listing_id")
  status        MatchStatus         @default(SUGGESTED)
  note          String              @default("")
  updatedById   String              @map("updated_by_id")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  requirement   PropertyRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([requirementId, listingId])
  @@index([companyId, listingId])
  @@map("requirement_matches")
}

// ---------- Deals: the transaction pipeline (Phase 8b) ----------

enum DealType {
  SALE
  RENT
  LEASE
}

enum DealStage {
  ENQUIRY
  VIEWING
  OFFER
  NEGOTIATION
  AGREED
  LEGAL
  COMPLETED
}

enum DealStatus {
  OPEN
  ON_HOLD
  DISPUTED
  COMPLETED
  CANCELLED
}

enum DealEventKind {
  OPENED
  STAGE
  STATUS
  REASSIGNED
  VIEWING
  OFFER
  NOTE
}

enum ViewingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum OfferSide {
  CLIENT
  OWNER
}

enum OfferStatus {
  OPEN
  COUNTERED
  REJECTED
  WITHDRAWN
  ACCEPTANCE_REQUESTED
  ACCEPTED
}

/// A transaction from enquiry to completion: one client, one property, one owner.
model Deal {
  id               String     @id @default(uuid())
  companyId        String     @map("company_id")
  ref              String
  type             DealType
  stage            DealStage  @default(ENQUIRY)
  status           DealStatus @default(OPEN)
  title            String
  clientId         String     @map("client_id")
  leadId           String?    @unique @map("lead_id")
  assetId          String     @map("asset_id")
  listingId        String?    @map("listing_id")
  ownerId          String     @map("owner_id")
  askingKobo       BigInt     @map("asking_kobo")
  agreedKobo       BigInt?    @map("agreed_kobo")
  agreedAt         DateTime?  @map("agreed_at")
  expectedCloseOn  DateTime?  @map("expected_close_on") @db.Date
  holdReason       String     @default("") @map("hold_reason")
  disputeReason    String     @default("") @map("dispute_reason")
  disputedById     String?    @map("disputed_by_id")
  disputedAt       DateTime?  @map("disputed_at")
  disputeOutcome   String     @default("") @map("dispute_outcome")
  cancelReason     String     @default("") @map("cancel_reason")
  cancelledById    String?    @map("cancelled_by_id")
  cancelledAt      DateTime?  @map("cancelled_at")
  completedById    String?    @map("completed_by_id")
  completedAt      DateTime?  @map("completed_at")
  createdById      String     @map("created_by_id")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  client           Client     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  asset            Asset      @relation(fields: [assetId], references: [id], onDelete: Restrict)
  events           DealEvent[]
  viewings         Viewing[]
  offers           Offer[]
  commission       DealCommission?
  documents        DealDocument[]
  payments         DealPayment[]

  @@unique([companyId, ref])
  @@index([companyId, status, stage])
  @@index([companyId, ownerId])
  @@index([clientId])
  @@index([assetId])
  @@map("deals")
}

/// Every stage change, status change, reassignment and notable step on a deal. Never edited.
model DealEvent {
  id         String        @id @default(uuid())
  companyId  String        @map("company_id")
  dealId     String        @map("deal_id")
  kind       DealEventKind
  fromStage  DealStage?    @map("from_stage")
  toStage    DealStage?    @map("to_stage")
  fromStatus DealStatus?   @map("from_status")
  toStatus   DealStatus?   @map("to_status")
  summary    String
  reason     String        @default("")
  actorId    String        @map("actor_id")
  createdAt  DateTime      @default(now()) @map("created_at")
  deal       Deal          @relation(fields: [dealId], references: [id], onDelete: Restrict)

  @@index([dealId, createdAt])
  @@map("deal_events")
}

/// A booked viewing or inspection appointment at the property.
model Viewing {
  id             String        @id @default(uuid())
  companyId      String        @map("company_id")
  dealId         String        @map("deal_id")
  assetId        String        @map("asset_id")
  agentId        String        @map("agent_id")
  startsAt       DateTime      @map("starts_at")
  endsAt         DateTime      @map("ends_at")
  meetingPoint   String        @default("") @map("meeting_point")
  status         ViewingStatus @default(SCHEDULED)
  outcome        String        @default("")
  cancelReason   String        @default("") @map("cancel_reason")
  rescheduledCount Int         @default(0) @map("rescheduled_count")
  createdById    String        @map("created_by_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  deal           Deal          @relation(fields: [dealId], references: [id], onDelete: Restrict)

  @@index([companyId, agentId, startsAt])
  @@index([companyId, assetId, startsAt])
  @@index([dealId])
  @@map("viewings")
}

/// An offer or counteroffer. A counteroffer points to the offer it answers, which keeps the negotiation history.
model Offer {
  id                  String      @id @default(uuid())
  companyId           String      @map("company_id")
  dealId              String      @map("deal_id")
  parentId            String?     @map("parent_id")
  side                OfferSide
  amountKobo          BigInt      @map("amount_kobo")
  conditions          String      @default("")
  validUntil          DateTime?   @map("valid_until") @db.Date
  status              OfferStatus @default(OPEN)
  note                String      @default("")
  recordedById        String      @map("recorded_by_id")
  acceptRequestedById String?     @map("accept_requested_by_id")
  acceptRequestedAt   DateTime?   @map("accept_requested_at")
  decidedById         String?     @map("decided_by_id")
  decidedAt           DateTime?   @map("decided_at")
  decisionNote        String      @default("") @map("decision_note")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")
  deal                Deal        @relation(fields: [dealId], references: [id], onDelete: Restrict)

  @@index([dealId, createdAt])
  @@map("offers")
}

// ---------- Deal file: documents and payments (Phase 8b-2) ----------

enum DealDocKind {
  OFFER_LETTER
  SALES_AGREEMENT
  TENANCY_AGREEMENT
  TITLE_DOCUMENT
  SURVEY
  IDENTITY
  PROOF_OF_FUNDS
  LEGAL
  OTHER
}

enum DealPaymentKind {
  BOOKING_DEPOSIT
  PART_PAYMENT
  BALANCE
  AGENCY_FEE
  LEGAL_FEE
  REFUND
  OTHER
}

/// A file on a deal, served only through an authorized route.
model DealDocument {
  id           String      @id @default(uuid())
  companyId    String      @map("company_id")
  dealId       String      @map("deal_id")
  kind         DealDocKind
  title        String
  fileName     String      @map("file_name")
  mimeType     String      @map("mime_type")
  sizeBytes    Int         @map("size_bytes")
  storageKey   String      @unique @map("storage_key")
  uploadedById String      @map("uploaded_by_id")
  createdAt    DateTime    @default(now()) @map("created_at")
  deal         Deal        @relation(fields: [dealId], references: [id], onDelete: Restrict)

  @@index([companyId, dealId])
  @@map("deal_documents")
}

/// Money received or paid in connection with a deal. Never edited: a mistake is reversed by a second person, which adds a row.
model DealPayment {
  id           String          @id @default(uuid())
  companyId    String          @map("company_id")
  dealId       String          @map("deal_id")
  kind         DealPaymentKind
  amountKobo   BigInt          @map("amount_kobo")
  paidOn       DateTime        @map("paid_on") @db.Date
  method       String          @default("")
  reference    String          @default("")
  note         String          @default("")
  reversesId   String?         @unique @map("reverses_id")
  recordedById String          @map("recorded_by_id")
  createdAt    DateTime        @default(now()) @map("created_at")
  deal         Deal            @relation(fields: [dealId], references: [id], onDelete: Restrict)

  @@index([companyId, dealId, paidOn])
  @@map("deal_payments")
}

// ---------- Commission (Phase 8c) ----------

enum CommissionMethod {
  PERCENT
  FIXED
}

enum CommissionApplies {
  ALL
  SALE
  RENT
  LEASE
}

enum CommissionStatus {
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
  PAID
}

enum SplitRole {
  LISTING_AGENT
  SELLING_AGENT
  TEAM_LEAD
  REFERRAL
  OTHER
}

/// A commission rule set by the company. Rules are never edited: stop using one and add another.
model CommissionRule {
  id          String            @id @default(uuid())
  companyId   String            @map("company_id")
  name        String
  applies     CommissionApplies @default(ALL)
  method      CommissionMethod
  rateBps     Int?              @map("rate_bps")
  fixedKobo   BigInt?           @map("fixed_kobo")
  active      Boolean           @default(true)
  createdById String            @map("created_by_id")
  createdAt   DateTime          @default(now()) @map("created_at")

  @@unique([companyId, name])
  @@map("commission_rules")
}

/// The commission on a completed deal. It copies the rule's figures when proposed, so later rule changes never alter it.
model DealCommission {
  id            String           @id @default(uuid())
  companyId     String           @map("company_id")
  dealId        String           @unique @map("deal_id")
  ruleId        String           @map("rule_id")
  ruleName      String           @map("rule_name")
  method        CommissionMethod
  rateBps       Int?             @map("rate_bps")
  fixedKobo     BigInt?          @map("fixed_kobo")
  basisKobo     BigInt           @map("basis_kobo")
  totalKobo     BigInt           @map("total_kobo")
  status        CommissionStatus @default(SUBMITTED)
  submittedById String           @map("submitted_by_id")
  submittedAt   DateTime         @default(now()) @map("submitted_at")
  decidedById   String?          @map("decided_by_id")
  decidedAt     DateTime?        @map("decided_at")
  decisionNote  String           @default("") @map("decision_note")
  paidAt        DateTime?        @map("paid_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  deal          Deal             @relation(fields: [dealId], references: [id], onDelete: Restrict)
  splits        CommissionSplit[]

  @@index([companyId, status])
  @@map("deal_commissions")
}

/// One person's share of a commission, and whether it has been paid.
model CommissionSplit {
  id           String         @id @default(uuid())
  companyId    String         @map("company_id")
  commissionId String         @map("commission_id")
  membershipId String         @map("membership_id")
  role         SplitRole
  shareBps     Int            @map("share_bps")
  amountKobo   BigInt         @map("amount_kobo")
  paidAt       DateTime?      @map("paid_at")
  paidById     String?        @map("paid_by_id")
  payReference String         @default("") @map("pay_reference")
  createdAt    DateTime       @default(now()) @map("created_at")
  commission   DealCommission @relation(fields: [commissionId], references: [id], onDelete: Cascade)

  @@unique([commissionId, membershipId])
  @@index([companyId, membershipId])
  @@map("commission_splits")
}

// ---------- Phase 9: subscriptions, following, profiles and notifications ----------

enum PlanAudience {
  SEEKER
  AGENT
  COMPANY
}

enum BillingPeriod {
  NONE
  MONTHLY
  QUARTERLY
  YEARLY
}

enum SubscriptionOwner {
  USER
  COMPANY
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  CANCELLED
}

enum SubscriptionEventKind {
  ASSIGNED
  RENEWED
  PLAN_CHANGED
  CANCELLED
}

enum FollowTarget {
  AGENT
  COMPANY
  DEVELOPER
}

enum ProfileKind {
  COMPANY
  DEVELOPER
}

/// A plan the platform administrator controls: name, price, billing period, trial, expiry policy and entitlements.
model SubscriptionPlan {
  id            String             @id @default(uuid())
  code          String             @unique
  name          String
  audience      PlanAudience
  priceKobo     BigInt?            @map("price_kobo")
  billingPeriod BillingPeriod      @default(NONE) @map("billing_period")
  trialDays     Int                @default(0) @map("trial_days")
  graceDays     Int                @default(7) @map("grace_days")
  readOnlyDays  Int                @default(30) @map("read_only_days")
  active        Boolean            @default(true)
  sortOrder     Int                @default(0) @map("sort_order")
  tier          PlanTier           @default(BASIC)
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  entitlements  PlanEntitlement[]
  subscriptions Subscription[]

  @@map("subscription_plans")
}

/// One feature a plan allows. `limit` is a count where the feature is counted; null means no count applies.
model PlanEntitlement {
  id     String           @id @default(uuid())
  planId String           @map("plan_id")
  key    String
  limit  Int?
  plan   SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
  @@map("plan_entitlements")
}

/// What a person or a company holds now. Exactly one of the two owners is set. Payment is recorded by the platform administrator
/// until the payments module exists; the period end drives the grace, read-only and suspended states.
model Subscription {
  id             String             @id @default(uuid())
  ownerKind      SubscriptionOwner  @map("owner_kind")
  ownerUserId    String?            @unique @map("owner_user_id")
  ownerCompanyId String?            @unique @map("owner_company_id")
  planId         String             @map("plan_id")
  status         SubscriptionStatus @default(ACTIVE)
  startedAt      DateTime           @default(now()) @map("started_at")
  periodEnd      DateTime           @map("period_end")
  cancelledAt    DateTime?          @map("cancelled_at")
  createdById    String             @map("created_by_id")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  plan           SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  events         SubscriptionEvent[]

  @@map("subscriptions")
}

/// The billing history of one subscription. Append-only.
model SubscriptionEvent {
  id             String                @id @default(uuid())
  subscriptionId String                @map("subscription_id")
  kind           SubscriptionEventKind
  fromPlanId     String?               @map("from_plan_id")
  toPlanId       String                @map("to_plan_id")
  periodEnd      DateTime              @map("period_end")
  note           String                @default("")
  actorId        String                @map("actor_id")
  createdAt      DateTime              @default(now()) @map("created_at")
  subscription   Subscription          @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
  @@map("subscription_events")
}

/// Platform-wide settings the administrator controls (messaging limits, contact policy, invitation expiry).
model PlatformSetting {
  key         String   @id
  value       String
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by_id")

  @@map("platform_settings")
}

/// A person following an agent (target is the agent's user), a company or a developer (target is the company). Following grants no access to anything.
model Follow {
  id         String       @id @default(uuid())
  followerId String       @map("follower_id")
  targetKind FollowTarget @map("target_kind")
  targetId   String       @map("target_id")
  createdAt  DateTime     @default(now()) @map("created_at")

  @@unique([followerId, targetKind, targetId])
  @@index([targetKind, targetId])
  @@map("follows")
}

/// What an agent chooses to show the public. Nothing is listed until the agent ticks "listed".
model AgentProfile {
  id              String   @id @default(uuid())
  membershipId    String   @unique @map("membership_id")
  userId          String   @map("user_id")
  companyId       String   @map("company_id")
  displayName     String   @map("display_name")
  companyName     String   @default("") @map("company_name")
  headline        String   @default("")
  bio             String   @default("")
  listed          Boolean  @default(false)
  acceptsMessages Boolean  @default(true) @map("accepts_messages")
  followerCount   Int      @default(0) @map("follower_count")
  platformHidden  Boolean  @default(false) @map("platform_hidden")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([listed])
  @@map("agent_profiles")
}

/// What a company chooses to show the public, as a company or as a developer.
model CompanyProfile {
  id            String      @id @default(uuid())
  companyId     String      @unique @map("company_id")
  kind          ProfileKind @default(COMPANY)
  displayName   String      @map("display_name")
  tagline       String      @default("")
  about         String      @default("")
  listed        Boolean     @default(false)
  followerCount Int         @default(0) @map("follower_count")
  platformHidden Boolean    @default(false) @map("platform_hidden")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@index([listed, kind])
  @@map("company_profiles")
}

/// An in-app notice for one person. Nothing is emailed or sent to a phone.
model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  kind      String
  title     String
  body      String    @default("")
  link      String    @default("")
  createdAt DateTime  @default(now()) @map("created_at")
  readAt    DateTime? @map("read_at")

  @@index([userId, readAt])
  @@map("notifications")
}

// ---------- Phase 9b: collaboration ----------

enum CollabKind {
  SEEKER_AGENT
  COMPANY_COMPANY
}

enum CollabPurpose {
  SEARCH_ASSISTANCE
  TRANSACTION
  INSPECTION
  DOCUMENT_EXCHANGE
  CO_LISTING
  REFERRAL
  CO_BROKERAGE
  MARKETING
  DEVELOPMENT
  CONTRACTOR
  OTHER
}

enum CollabStatus {
  DRAFT
  PENDING
  ACTIVE
  DECLINED
  EXPIRED
  CANCELLED
  COMPLETED
  SUSPENDED
}

enum CollabSide {
  SENDER
  RECIPIENT
}

enum CollabItemKind {
  PROPERTY
  DEAL_SUMMARY
  DOCUMENT
  NOTE
}

enum CollabTaskStatus {
  OPEN
  DONE
  CANCELLED
}

/// An invitation to work together, and once accepted the workspace for it. Either a seeker and an agent, or two companies.
/// Both parties can read the row; neither gains access to the other's own records. Only what a party puts into the workspace is shared.
model Collaboration {
  id                 String       @id @default(uuid())
  ref                String       @unique
  kind               CollabKind
  purpose            CollabPurpose
  title              String
  scope              String       @default("")
  terms              String       @default("")
  status             CollabStatus @default(DRAFT)
  senderUserId       String       @map("sender_user_id")
  senderCompanyId    String?      @map("sender_company_id")
  senderName         String       @map("sender_name")
  recipientUserId    String?      @map("recipient_user_id")
  recipientCompanyId String?      @map("recipient_company_id")
  recipientName      String       @map("recipient_name")
  sentAt             DateTime?    @map("sent_at")
  expiresAt          DateTime?    @map("expires_at")
  endsOn             DateTime?    @map("ends_on") @db.Date
  respondedAt        DateTime?    @map("responded_at")
  respondedById      String?      @map("responded_by_id")
  responseNote       String       @default("") @map("response_note")
  closedAt           DateTime?    @map("closed_at")
  closedById         String?      @map("closed_by_id")
  closeReason        String       @default("") @map("close_reason")
  suspendedAt        DateTime?    @map("suspended_at")
  suspendedById      String?      @map("suspended_by_id")
  suspendedBy        String?      @map("suspended_by")
  suspendReason      String       @default("") @map("suspend_reason")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  participants       CollabParticipant[]
  items              CollabItem[]
  tasks              CollabTask[]
  comments           CollabComment[]
  events             CollabEvent[]

  @@index([senderCompanyId, status])
  @@index([recipientCompanyId, status])
  @@index([senderUserId])
  @@index([recipientUserId])
  @@map("collaborations")
}

/// A person who may work in the workspace, with what they may do and until when. Revoking takes effect at once.
model CollabParticipant {
  id              String        @id @default(uuid())
  collaborationId String        @map("collaboration_id")
  side            CollabSide
  userId          String        @map("user_id")
  companyId       String?       @map("company_id")
  name            String
  canComment      Boolean       @default(true) @map("can_comment")
  canTasks        Boolean       @default(true) @map("can_tasks")
  canShare        Boolean       @default(true) @map("can_share")
  canDocuments    Boolean       @default(true) @map("can_documents")
  expiresAt       DateTime?     @map("expires_at")
  revokedAt       DateTime?     @map("revoked_at")
  revokedById     String?       @map("revoked_by_id")
  revokeReason    String        @default("") @map("revoke_reason")
  addedById       String        @map("added_by_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  collaboration   Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)

  @@unique([collaborationId, userId])
  @@index([userId])
  @@map("collab_participants")
}

/// One thing a party chose to share. It is a copy of the fields they ticked, not a live link to their records. Revoking wipes the copy.
model CollabItem {
  id               String         @id @default(uuid())
  collaborationId  String         @map("collaboration_id")
  kind             CollabItemKind
  title            String
  summary          String         @default("")
  details          Json           @default("{}")
  sourceType       String         @default("") @map("source_type")
  sourceId         String         @default("") @map("source_id")
  side             CollabSide
  sharedById       String         @map("shared_by_id")
  sharedByName     String         @map("shared_by_name")
  sharedByCompanyId String?       @map("shared_by_company_id")
  version          Int            @default(1)
  fileKey          String?        @map("file_key")
  fileName         String         @default("") @map("file_name")
  mimeType         String         @default("") @map("mime_type")
  sizeBytes        Int            @default(0) @map("size_bytes")
  revokedAt        DateTime?      @map("revoked_at")
  revokedById      String?        @map("revoked_by_id")
  revokeReason     String         @default("") @map("revoke_reason")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  collaboration    Collaboration  @relation(fields: [collaborationId], references: [id], onDelete: Cascade)

  @@index([collaborationId, createdAt])
  @@map("collab_items")
}

/// The bytes of a shared document, kept apart from either company's own stored files.
model CollabFile {
  key             String   @id
  collaborationId String   @map("collaboration_id")
  bytes           Bytes
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([collaborationId])
  @@map("collab_files")
}

model CollabTask {
  id              String           @id @default(uuid())
  collaborationId String           @map("collaboration_id")
  title           String
  description     String           @default("")
  milestone       Boolean          @default(false)
  assigneeId      String?          @map("assignee_id")
  assigneeName    String           @default("") @map("assignee_name")
  dueOn           DateTime?        @map("due_on") @db.Date
  status          CollabTaskStatus @default(OPEN)
  outcome         String           @default("")
  createdById     String           @map("created_by_id")
  createdByName   String           @map("created_by_name")
  completedAt     DateTime?        @map("completed_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  collaboration   Collaboration    @relation(fields: [collaborationId], references: [id], onDelete: Cascade)

  @@index([collaborationId, status])
  @@map("collab_tasks")
}

model CollabComment {
  id              String        @id @default(uuid())
  collaborationId String        @map("collaboration_id")
  itemId          String?       @map("item_id")
  authorId        String        @map("author_id")
  authorName      String        @map("author_name")
  body            String
  createdAt       DateTime      @default(now()) @map("created_at")
  collaboration   Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)

  @@index([collaborationId, createdAt])
  @@map("collab_comments")
}

/// The workspace's history: who did what, when. Append-only.
model CollabEvent {
  id              String        @id @default(uuid())
  collaborationId String        @map("collaboration_id")
  actorId         String?       @map("actor_id")
  actorName       String        @map("actor_name")
  kind            String
  summary         String
  createdAt       DateTime      @default(now()) @map("created_at")
  collaboration   Collaboration @relation(fields: [collaborationId], references: [id], onDelete: Cascade)

  @@index([collaborationId, createdAt])
  @@map("collab_events")
}

// ---------- Phase 9c: secure messaging ----------

enum MessageKind {
  TEXT
  PROPERTY
  INSPECTION_REQUEST
  INSPECTION_REPLY
}

enum ModerationStatus {
  OPEN
  ACTIONED
  DISMISSED
}

model Conversation {
  id              String               @id @default(uuid())
  subject         String               @default("")
  collaborationId String?              @map("collaboration_id")
  createdById     String               @map("created_by_id")
  createdAt       DateTime             @default(now()) @map("created_at")
  lastMessageAt   DateTime             @default(now()) @map("last_message_at")
  members         ConversationMember[]
  messages        Message[]
  flatmateRoom    FlatmateRoom?

  @@index([lastMessageAt])
  @@index([createdById, createdAt])
  @@map("conversations")
}

model ConversationMember {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  userId         String       @map("user_id")
  name           String
  lastReadAt     DateTime?    @map("last_read_at")
  joinedAt       DateTime     @default(now()) @map("joined_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             String          @id @default(uuid())
  conversationId String          @map("conversation_id")
  senderId       String          @map("sender_id")
  senderName     String          @map("sender_name")
  kind           MessageKind     @default(TEXT)
  body           String          @default("")
  details        Json            @default("{}")
  masked         Boolean         @default(false)
  replyToId      String?         @map("reply_to_id")
  createdAt      DateTime        @default(now()) @map("created_at")
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  reports        MessageReport[]

  @@index([conversationId, createdAt])
  @@index([senderId, createdAt])
  @@map("messages")
}

model UserBlock {
  id        String   @id @default(uuid())
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([blockerId, blockedId])
  @@map("user_blocks")
}

model MessageReport {
  id          String       @id @default(uuid())
  messageId   String       @map("message_id")
  reporterId  String       @map("reporter_id")
  reporterName String      @map("reporter_name")
  senderId    String       @map("sender_id")
  reason      String
  status      ModerationStatus @default(OPEN)
  handledById String?      @map("handled_by_id")
  handledAt   DateTime?    @map("handled_at")
  handlerNote String       @default("") @map("handler_note")
  createdAt   DateTime     @default(now()) @map("created_at")
  message     Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, reporterId])
  @@index([status, senderId])
  @@map("message_reports")
}

model MessagingRestriction {
  id          String    @id @default(uuid())
  userId      String    @unique @map("user_id")
  reason      String
  setById     String    @map("set_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  liftedAt    DateTime? @map("lifted_at")
  liftedById  String?   @map("lifted_by_id")

  @@map("messaging_restrictions")
}

// ---------- Phase 10a: rewards and referrals ----------

enum RewardProgramme {
  REFERRAL
  VACANCY
}

enum RewardEvent {
  REFERRAL_REGISTERED
  REFERRAL_LISTING_PUBLISHED
  REFERRAL_SUBSCRIBED
  REFERRAL_CUSTOM
  VACANCY_VERIFIED
  VACANCY_LISTED
  VACANCY_TRANSACTION
}

enum RewardStatus {
  NOT_ELIGIBLE
  UNDER_REVIEW
  ELIGIBLE
  APPROVED
  PAYABLE
  PAID
  REJECTED
  CANCELLED
  DISPUTED
}

enum PayoutStatus {
  PENDING
  PAID
  FAILED
}

enum ReferralAudience {
  SEEKER
  OWNER
  AGENT
  COMPANY
  DEVELOPER
  VENDOR
  SUBSCRIBER
  LISTING
  OTHER
}

enum AttributionStatus {
  REGISTERED
  QUALIFIED
  REJECTED
  EXPIRED
}

enum ReviewState {
  CLEAR
  FLAGGED
  CLEARED
  CONFIRMED_ABUSE
}

enum DisputeStatus {
  OPEN
  UPHELD
  DENIED
}

enum DisputeSubject {
  REWARD
  VACANCY_REPORT
}

/// A reward amount for one programme event. Never edited: a change retires it and adds the next version, so a dispute can be judged on the policy in force at the time.
model RewardPolicy {
  id             String          @id @default(uuid())
  programme      RewardProgramme
  event          RewardEvent
  campaignId     String?         @map("campaign_id")
  version        Int
  name           String
  amountKobo     BigInt          @map("amount_kobo")
  holdDays       Int             @default(14) @map("hold_days")
  perPersonLimit Int?            @map("per_person_limit")
  active         Boolean         @default(true)
  terms          String          @default("")
  retiredAt      DateTime?       @map("retired_at")
  createdById    String          @map("created_by_id")
  createdAt      DateTime        @default(now()) @map("created_at")

  @@index([programme, event, active])
  @@map("reward_policies")
}

/// The most the platform will approve for a programme in one month.
model RewardBudget {
  id          String          @id @default(uuid())
  programme   RewardProgramme
  month       String
  limitKobo   BigInt          @map("limit_kobo")
  updatedById String          @map("updated_by_id")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@unique([programme, month])
  @@map("reward_budgets")
}

model Reward {
  id            String          @id @default(uuid())
  ref           String          @unique
  userId        String          @map("user_id")
  programme     RewardProgramme
  event         RewardEvent
  policyId      String?         @map("policy_id")
  policyVersion Int?            @map("policy_version")
  amountKobo    BigInt          @map("amount_kobo")
  status        RewardStatus
  reason        String          @default("")
  flag          String          @default("")
  sourceType    String          @map("source_type")
  sourceId      String          @map("source_id")
  sourceLabel   String          @default("") @map("source_label")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  approvedAt    DateTime?       @map("approved_at")
  approvedById  String?         @map("approved_by_id")
  payableAt     DateTime?       @map("payable_at")
  paidAt        DateTime?       @map("paid_at")
  payoutId      String?         @map("payout_id")
  ledger        RewardLedgerEntry[]

  @@unique([sourceType, sourceId, event])
  @@index([userId, status])
  @@index([status, payableAt])
  @@map("rewards")
}

/// Every change to a reward, kept for good. Rows are never updated or deleted.
model RewardLedgerEntry {
  id         String        @id @default(uuid())
  rewardId   String        @map("reward_id")
  userId     String        @map("user_id")
  fromStatus RewardStatus? @map("from_status")
  toStatus   RewardStatus  @map("to_status")
  amountKobo BigInt        @map("amount_kobo")
  actorId    String?       @map("actor_id")
  actorName  String        @map("actor_name")
  note       String        @default("")
  createdAt  DateTime      @default(now()) @map("created_at")
  reward     Reward        @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@index([rewardId, createdAt])
  @@index([userId, createdAt])
  @@map("reward_ledger")
}

model RewardPayout {
  id            String       @id @default(uuid())
  ref           String       @unique
  userId        String       @map("user_id")
  amountKobo    BigInt       @map("amount_kobo")
  status        PayoutStatus @default(PENDING)
  method        String       @default("BANK_TRANSFER")
  reference     String       @default("")
  note          String       @default("")
  failureReason String       @default("") @map("failure_reason")
  createdById   String       @map("created_by_id")
  createdByName String       @map("created_by_name")
  createdAt     DateTime     @default(now()) @map("created_at")
  verifiedById  String?      @map("verified_by_id")
  verifiedAt    DateTime?    @map("verified_at")

  @@index([userId])
  @@index([status])
  @@map("reward_payouts")
}

model RewardRestriction {
  id         String    @id @default(uuid())
  userId     String    @unique @map("user_id")
  reason     String
  setById    String    @map("set_by_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  liftedAt   DateTime? @map("lifted_at")
  liftedById String?   @map("lifted_by_id")

  @@map("reward_restrictions")
}

model RewardDispute {
  id           String         @id @default(uuid())
  subjectType  DisputeSubject @map("subject_type")
  subjectId    String         @map("subject_id")
  userId       String         @map("user_id")
  reason       String
  status       DisputeStatus  @default(OPEN)
  resolution   String         @default("")
  resolvedById String?        @map("resolved_by_id")
  resolvedAt   DateTime?      @map("resolved_at")
  createdAt    DateTime       @default(now()) @map("created_at")

  @@index([status])
  @@index([subjectType, subjectId])
  @@map("reward_disputes")
}

model ReferralCampaign {
  id                    String           @id @default(uuid())
  name                  String
  audience              ReferralAudience
  event                 RewardEvent
  description           String           @default("")
  startsOn              DateTime         @map("starts_on")
  endsOn                DateTime?        @map("ends_on")
  attributionDays       Int              @default(30) @map("attribution_days")
  qualifyWithinDays     Int              @default(60) @map("qualify_within_days")
  maxRewardsPerReferrer Int?             @map("max_rewards_per_referrer")
  active                Boolean          @default(true)
  createdById           String           @map("created_by_id")
  createdAt             DateTime         @default(now()) @map("created_at")

  @@index([active, audience])
  @@map("referral_campaigns")
}

model ReferralCode {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  code      String   @unique
  active    Boolean  @default(true)
  clicks    Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("referral_codes")
}

model ReferralAttribution {
  id                String            @id @default(uuid())
  ref               String            @unique
  codeId            String            @map("code_id")
  referrerId        String            @map("referrer_id")
  referredUserId    String            @unique @map("referred_user_id")
  referredName      String            @map("referred_name")
  referredCompanyId String?           @map("referred_company_id")
  campaignId        String            @map("campaign_id")
  registeredAt      DateTime          @default(now()) @map("registered_at")
  status            AttributionStatus @default(REGISTERED)
  signals           String            @default("")
  reviewState       ReviewState       @default(CLEAR) @map("review_state")
  reviewNote        String            @default("") @map("review_note")
  reviewedById      String?           @map("reviewed_by_id")
  rejectReason      String            @default("") @map("reject_reason")
  qualifiedAt       DateTime?         @map("qualified_at")

  @@index([referrerId])
  @@index([campaignId, status])
  @@index([referredCompanyId])
  @@map("referral_attributions")
}

// ---------- Phase 10b: vacancy reports (the whistle-blower programme) ----------

enum VacancyStage {
  SUBMITTED
  DUPLICATE_CHECK
  INITIAL_REVIEW
  LOCATION_VERIFICATION
  AVAILABILITY_CONFIRMATION
  OWNER_VERIFICATION
  REWARD_REVIEW
}

enum VacancyOutcome {
  OPEN
  APPROVED
  REJECTED
  NEEDS_INFO
  MERGED
  WITHDRAWN
}

enum VacancyLeadStatus {
  CONTACTING
  AUTHORISED
  DECLINED
  WITHDRAWN
}

/// Someone saw a vacant property and told us. This is a sighting, not a listing: nothing here is ever published.
model VacancyReport {
  id               String         @id @default(uuid())
  ref              String         @unique
  reporterId       String         @map("reporter_id")
  reporterName     String         @map("reporter_name")
  propertyType     String         @map("property_type")
  purpose          String         @default("UNKNOWN")
  bedrooms         Int?
  address          String
  area             String
  city             String
  state            String
  lat              Float?
  lng              Float?
  addressKey       String         @map("address_key")
  description      String
  descriptionHash  String         @map("description_hash")
  observedOn       DateTime       @map("observed_on") @db.Date
  ownerContact     String         @default("") @map("owner_contact")
  allowContact     Boolean        @default(false) @map("allow_contact")
  showNameToOwner  Boolean        @default(false) @map("show_name_to_owner")
  stage            VacancyStage   @default(SUBMITTED)
  outcome          VacancyOutcome @default(OPEN)
  signals          String         @default("")
  flagged          Boolean        @default(false)
  clusterId        String         @map("cluster_id")
  duplicateOfId    String?        @map("duplicate_of_id")
  mergedIntoId     String?        @map("merged_into_id")
  reviewNote       String         @default("") @map("review_note")
  rejectReason     String         @default("") @map("reject_reason")
  question         String         @default("")
  reply            String         @default("")
  appealedAt       DateTime?      @map("appealed_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  closedAt         DateTime?      @map("closed_at")
  files            VacancyFile[]
  events           VacancyEvent[]
  lead             VacancyLead?

  @@index([reporterId, createdAt])
  @@index([stage, outcome])
  @@index([clusterId])
  @@index([addressKey])
  @@index([descriptionHash])
  @@index([state, city, area])
  @@map("vacancy_reports")
}

model VacancyFile {
  id        String        @id @default(uuid())
  reportId  String        @map("report_id")
  name      String
  mimeType  String        @map("mime_type")
  sizeBytes Int           @map("size_bytes")
  sha256    String
  bytes     Bytes
  createdAt DateTime      @default(now()) @map("created_at")
  report    VacancyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([sha256])
  @@map("vacancy_files")
}

/// The history of a report. Entries marked toReporter are shown to the person who reported; the rest are the reviewers' own notes.
model VacancyEvent {
  id         String         @id @default(uuid())
  reportId   String         @map("report_id")
  stage      VacancyStage?
  outcome    VacancyOutcome?
  actorName  String         @map("actor_name")
  note       String         @default("")
  toReporter Boolean        @default(true) @map("to_reporter")
  createdAt  DateTime       @default(now()) @map("created_at")
  report     VacancyReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, createdAt])
  @@map("vacancy_events")
}

/// Permission to advertise is a separate matter from having seen the property. A lead records who we spoke to and whether they agreed.
model VacancyLead {
  id                String            @id @default(uuid())
  reportId          String            @unique @map("report_id")
  status            VacancyLeadStatus @default(CONTACTING)
  contactName       String            @map("contact_name")
  authorisationNote String            @default("") @map("authorisation_note")
  authorisedAt      DateTime?         @map("authorised_at")
  listingId         String?           @map("listing_id")
  createdById       String            @map("created_by_id")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  report            VacancyReport     @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("vacancy_leads")
}


// ---------- Phase 11: tiers, promotions and platform ratings ----------

enum PlanTier {
  BASIC
  SILVER
  GOLD
}

enum PromoStatus {
  REQUESTED
  APPROVED
  REJECTED
  WITHDRAWN
}

enum PromoPaymentStatus {
  NOT_REQUIRED
  PENDING
  VERIFIED
}

enum PromoTheme {
  RED
  GOLD
  GREEN
  PURPLE
  BLUE
}

enum RatingStatus {
  NEW
  REVIEWED
  ACTIONED
}

/// A company's perks level right now, readable by everyone because the badge it earns is public. Kept in step with its subscription.
model CompanyTier {
  companyId  String   @id @map("company_id")
  tier       PlanTier
  validUntil DateTime @map("valid_until")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("company_tiers")
}

/// A sale the platform runs (Black Friday and the like). Companies choose which of their properties join.
model PromoCampaign {
  id             String     @id @default(uuid())
  name           String
  tagline        String     @default("")
  theme          PromoTheme @default(RED)
  startsOn       DateTime   @map("starts_on")
  endsOn         DateTime   @map("ends_on")
  feeKobo        BigInt     @default(0) @map("fee_kobo")
  maxDiscountPct Int        @default(60) @map("max_discount_pct")
  active         Boolean    @default(true)
  createdById    String     @map("created_by_id")
  createdAt      DateTime   @default(now()) @map("created_at")
  entries        PromoEntry[]

  @@index([active, startsOn, endsOn])
  @@map("promo_campaigns")
}

/// One property in one campaign: the real price it was listed at, and the reviewed price it is offered at for the promotion.
model PromoEntry {
  id               String        @id @default(uuid())
  ref              String        @unique
  campaignId       String        @map("campaign_id")
  companyId        String        @map("company_id")
  listingId        String        @map("listing_id")
  originalPriceKobo BigInt       @map("original_price_kobo")
  promoPriceKobo   BigInt        @map("promo_price_kobo")
  status           PromoStatus   @default(REQUESTED)
  reviewNote       String        @default("") @map("review_note")
  requestedById    String        @map("requested_by_id")
  reviewedById     String?       @map("reviewed_by_id")
  reviewedAt       DateTime?     @map("reviewed_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  campaign         PromoCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  payment          PromoPayment?

  @@index([campaignId, listingId])
  @@index([companyId, status])
  @@index([listingId, status])
  @@map("promo_entries")
}

/// What a promotion costs. Silver and Gold companies pay nothing. Payment is made outside the platform and confirmed here by a person.
model PromoPayment {
  id           String             @id @default(uuid())
  entryId      String             @unique @map("entry_id")
  companyId    String             @map("company_id")
  tierAtRequest PlanTier          @map("tier_at_request")
  feeKobo      BigInt             @map("fee_kobo")
  status       PromoPaymentStatus
  reference    String             @default("")
  note         String             @default("")
  verifiedById String?            @map("verified_by_id")
  verifiedAt   DateTime?          @map("verified_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  entry        PromoEntry         @relation(fields: [entryId], references: [id], onDelete: Restrict)

  @@index([companyId, status])
  @@map("promo_payments")
}

/// What a person thinks of the platform, and what would make it serve them better.
model PlatformRating {
  id           String       @id @default(uuid())
  userId       String       @map("user_id")
  overall      Int
  easeScore    Int?         @map("ease_score")
  trustScore   Int?         @map("trust_score")
  supportScore Int?         @map("support_score")
  suggestion   String       @default("")
  anonymous    Boolean      @default(false)
  userKind     String       @map("user_kind")
  status       RatingStatus @default(NEW)
  adminNote    String       @default("") @map("admin_note")
  createdAt    DateTime     @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("platform_ratings")
}

model FeedbackState {
  userId       String    @id @map("user_id")
  lastRatedAt  DateTime? @map("last_rated_at")
  snoozedUntil DateTime? @map("snoozed_until")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("feedback_state")
}

// ---------- Phase 12a: verified reviews and reputation ----------

enum ReviewBasis {
  ENQUIRY
  INSPECTION
  TRANSACTION
}

enum ReviewStatus {
  PUBLISHED
  HELD
  HIDDEN
  REMOVED
}

enum ReviewCaseKind {
  DISPUTE
  APPEAL
}

enum ReviewCaseStatus {
  OPEN
  UPHELD
  REJECTED
}

/// A single-use link a company gives to a client after a completed viewing or deal, so that client can review them. The link, not the
/// client's say-so, is what makes the review verified. One link per deal or viewing.
model ReviewInvite {
  id          String      @id @default(uuid())
  tokenHash   String      @unique @map("token_hash")
  companyId   String      @map("company_id")
  agentUserId String?     @map("agent_user_id")
  basis       ReviewBasis
  basisRef    String      @map("basis_ref")
  createdById String      @map("created_by_id")
  expiresAt   DateTime    @map("expires_at")
  usedAt      DateTime?   @map("used_at")
  usedById    String?     @map("used_by_id")
  revokedAt   DateTime?   @map("revoked_at")
  createdAt   DateTime    @default(now()) @map("created_at")

  @@unique([basis, basisRef])
  @@index([companyId, createdAt])
  @@map("review_invites")
}

/// A review of an agent (agentUserId set) or of a company (agentUserId empty), tied to a real interaction.
model Review {
  id             String       @id @default(uuid())
  ref            String       @unique
  companyId      String       @map("company_id")
  agentUserId    String?      @map("agent_user_id")
  reviewerId     String       @map("reviewer_id")
  reviewerName   String       @map("reviewer_name")
  basis          ReviewBasis
  basisRef       String       @map("basis_ref")
  overall        Int
  communication  Int?
  professionalism Int?
  accuracy       Int?
  responsiveness Int?
  serviceQuality Int?         @map("service_quality")
  handling       Int?
  body           String       @default("")
  bodyHash       String       @default("") @map("body_hash")
  status         ReviewStatus @default(PUBLISHED)
  signals        String       @default("")
  response       String       @default("")
  respondedAt    DateTime?    @map("responded_at")
  respondedById  String?      @map("responded_by_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([reviewerId, basis, basisRef])
  @@index([companyId, status, createdAt])
  @@index([agentUserId, status, createdAt])
  @@index([reviewerId])
  @@map("reviews")
}

/// Everything that happened to a review. Never edited. toReviewer marks the lines the reviewer may read.
model ReviewEvent {
  id         String   @id @default(uuid())
  reviewId   String   @map("review_id")
  reviewerId String   @map("reviewer_id")
  actorName  String   @map("actor_name")
  kind       String
  note       String   @default("")
  toReviewer Boolean  @default(false) @map("to_reviewer")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([reviewId, createdAt])
  @@map("review_events")
}

model ReviewReport {
  id           String           @id @default(uuid())
  reviewId     String           @map("review_id")
  reporterId   String           @map("reporter_id")
  reason       String
  status       ModerationStatus @default(OPEN)
  handledById  String?          @map("handled_by_id")
  handledAt    DateTime?        @map("handled_at")
  createdAt    DateTime         @default(now()) @map("created_at")

  @@unique([reviewId, reporterId])
  @@index([status, createdAt])
  @@map("review_reports")
}

/// The reviewed party's dispute of a published review, or the reviewer's appeal of a decision to hide theirs. Once each per review.
model ReviewCase {
  id          String           @id @default(uuid())
  reviewId    String           @map("review_id")
  companyId   String           @map("company_id")
  kind        ReviewCaseKind
  openedById  String           @map("opened_by_id")
  reason      String
  status      ReviewCaseStatus @default(OPEN)
  decidedById String?          @map("decided_by_id")
  decidedAt   DateTime?        @map("decided_at")
  decision    String           @default("")
  createdAt   DateTime         @default(now()) @map("created_at")

  @@unique([reviewId, kind])
  @@index([status, createdAt])
  @@map("review_cases")
}

/// A reputation figure and the exact facts it was worked out from, so anyone can recompute it. Newest row per subject is current.
model ReputationSnapshot {
  id          String   @id @default(uuid())
  subjectKind String   @map("subject_kind")
  subjectId   String   @map("subject_id")
  score       Int
  reviewCount Int      @map("review_count")
  average     Float
  formula     Int
  inputs      Json
  components  Json
  badges      Json
  inputsHash  String   @map("inputs_hash")
  computedAt  DateTime @default(now()) @map("computed_at")

  @@index([subjectKind, subjectId, computedAt])
  @@map("reputation_snapshots")
}

// ---------- Phase 12b: monthly Top Agent awards and completed-transaction display ----------

enum AwardRunStatus {
  DRAFT
  PUBLISHED
  FROZEN
  SUPERSEDED
}

enum AwardPlaque {
  GOLD
  DIAMOND
  SILVER
}

enum CompletedKind {
  SOLD
  RENTED
  LEASED
}

enum CompletedStatus {
  REQUESTED
  APPROVED
  REJECTED
  WITHDRAWN
}

/// One calculation of one month's ranking. Each recalculation is a new version; only the newest is current. Settings used are stored.
model AwardRun {
  id            String         @id @default(uuid())
  month         String
  version       Int
  status        AwardRunStatus @default(DRAFT)
  config        Json
  inputsHash    String         @map("inputs_hash")
  computedById  String         @map("computed_by_id")
  computedAt    DateTime       @default(now()) @map("computed_at")
  publishedById String?        @map("published_by_id")
  publishedAt   DateTime?      @map("published_at")
  frozenById    String?        @map("frozen_by_id")
  frozenAt      DateTime?      @map("frozen_at")
  note          String         @default("")

  @@unique([month, version])
  @@index([month, status])
  @@map("award_runs")
}

/// One agent's line in a run: the facts, the normalised measures, the score and the place.
model AwardEntry {
  id          String       @id @default(uuid())
  runId       String       @map("run_id")
  userId      String       @map("user_id")
  displayName String       @map("display_name")
  companyName String       @default("") @map("company_name")
  eligible    Boolean
  reason      String       @default("")
  sales       Int
  posts       Int
  reviews     Int
  avgRating   Float        @map("avg_rating")
  ratingScore Float        @map("rating_score")
  normSales   Float        @map("norm_sales")
  normPosts   Float        @map("norm_posts")
  normRating  Float        @map("norm_rating")
  score       Float
  rank        Int?
  plaque      AwardPlaque?
  facts       Json

  @@unique([runId, userId])
  @@index([userId])
  @@index([runId, rank])
  @@map("award_entries")
}

/// An agent's challenge to their own line in a run, during the correction period.
model AwardDispute {
  id          String           @id @default(uuid())
  runId       String           @map("run_id")
  userId      String           @map("user_id")
  reason      String
  status      ReviewCaseStatus @default(OPEN)
  decidedById String?          @map("decided_by_id")
  decidedAt   DateTime?        @map("decided_at")
  decision    String           @default("")
  createdAt   DateTime         @default(now()) @map("created_at")

  @@unique([runId, userId])
  @@index([status, createdAt])
  @@map("award_disputes")
}

/// A company's request to show a completed deal in the Recently Sold, Rented or Leased sections. Only a snapshot of general facts is
/// kept here for the public; the price and the people are never included.
model CompletedDisplay {
  id            String          @id @default(uuid())
  dealId        String          @unique @map("deal_id")
  companyId     String          @map("company_id")
  listingId     String?         @map("listing_id")
  kind          CompletedKind
  category      String
  bedrooms      Int?
  city          String
  state         String
  completedAt   DateTime        @map("completed_at")
  status        CompletedStatus @default(REQUESTED)
  authorisedById String         @map("authorised_by_id")
  authorisation String          @map("authorisation")
  reviewNote    String          @default("") @map("review_note")
  reviewedById  String?         @map("reviewed_by_id")
  reviewedAt    DateTime?       @map("reviewed_at")
  createdAt     DateTime        @default(now()) @map("created_at")

  @@index([status, kind, completedAt])
  @@index([companyId, status])
  @@map("completed_displays")
}

// ---------- Phase 12c: Reels and social ----------

enum ReelStatus {
  PENDING
  PUBLISHED
  HIDDEN
  REMOVED
}

enum SocialReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

enum CommentStatus {
  VISIBLE
  HIDDEN
}

/// A short property video by a listed agent. Every reel is checked by the platform before anyone sees it.
model Reel {
  id          String     @id @default(uuid())
  authorId    String     @map("author_id")
  companyId   String     @map("company_id")
  listingId   String?    @map("listing_id")
  caption     String     @default("")
  city        String     @default("")
  mimeType    String     @map("mime_type")
  sizeBytes   Int        @map("size_bytes")
  status      ReelStatus @default(PENDING)
  reviewNote  String     @default("") @map("review_note")
  reviewedById String?   @map("reviewed_by_id")
  publishedAt DateTime?  @map("published_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([status, publishedAt])
  @@index([authorId, status])
  @@map("reels")
}

model ReelMedia {
  reelId String @id @map("reel_id")
  bytes  Bytes

  @@map("reel_media")
}

model ReelLike {
  id        String   @id @default(uuid())
  reelId    String   @map("reel_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([reelId, userId])
  @@index([userId])
  @@map("reel_likes")
}

model ReelSave {
  id        String   @id @default(uuid())
  reelId    String   @map("reel_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([reelId, userId])
  @@index([userId, createdAt])
  @@map("reel_saves")
}

model ReelShare {
  id        String   @id @default(uuid())
  reelId    String   @map("reel_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([reelId, userId])
  @@map("reel_shares")
}

model ReelComment {
  id        String        @id @default(uuid())
  reelId    String        @map("reel_id")
  userId    String        @map("user_id")
  authorName String       @map("author_name")
  body      String
  status    CommentStatus @default(VISIBLE)
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([reelId, createdAt])
  @@map("reel_comments")
}

/// A report about a reel or a comment. Targets are identified by kind and id so one table covers both.
model SocialReport {
  id         String             @id @default(uuid())
  targetKind String             @map("target_kind")
  targetId   String             @map("target_id")
  reelId     String             @map("reel_id")
  reporterId String             @map("reporter_id")
  reason     String
  status     SocialReportStatus @default(OPEN)
  decidedById String?           @map("decided_by_id")
  decidedAt  DateTime?          @map("decided_at")
  createdAt  DateTime           @default(now()) @map("created_at")

  @@unique([targetKind, targetId, reporterId])
  @@index([status, createdAt])
  @@map("social_reports")
}

// ---------- Phase 13: notifications and email ----------

enum EmailCategory {
  ESSENTIAL
  ACTIVITY
  PROMOTIONAL
}

enum EmailStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  DEAD
  SKIPPED
  HELD
  DIGESTED
}

enum DigestMode {
  INSTANT
  DAILY
}

/// What one person wants to receive by email. Optional categories are off until the person turns them on, where consent is needed.
model NotificationPref {
  id               String     @id @default(uuid())
  userId           String     @unique @map("user_id")
  emailActivity    Boolean    @default(true) @map("email_activity")
  emailAlerts      Boolean    @default(true) @map("email_alerts")
  emailPromotional Boolean    @default(false) @map("email_promotional")
  digest           DigestMode @default(INSTANT)
  quietStart       Int?       @map("quiet_start")
  quietEnd         Int?       @map("quiet_end")
  areas            String[]   @default([])
  updatedAt        DateTime   @updatedAt @map("updated_at")

  @@map("notification_prefs")
}

/// An email waiting to go, sent, failed or dropped. Who may receive it is decided when it is processed, not when it is queued.
model EmailOutbox {
  id                String        @id @default(uuid())
  userId            String        @map("user_id")
  kind              String
  category          EmailCategory
  template          String
  vars              Json
  dedupeKey         String        @unique @map("dedupe_key")
  status            EmailStatus   @default(QUEUED)
  attempts          Int           @default(0)
  nextAttemptAt     DateTime      @default(now()) @map("next_attempt_at")
  lastError         String        @default("") @map("last_error")
  skipReason        String        @default("") @map("skip_reason")
  provider          String        @default("")
  providerMessageId String        @default("") @map("provider_message_id")
  digestId          String?       @map("digest_id")
  createdAt         DateTime      @default(now()) @map("created_at")
  sentAt            DateTime?     @map("sent_at")

  @@index([status, nextAttemptAt])
  @@index([userId, status])
  @@index([category, createdAt])
  @@map("email_outbox")
}

/// A record of what the notification system decided, for the administrator's delivery figures. Append-only.
model NotificationLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  kind      String
  outcome   String
  detail    String   @default("")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([outcome, createdAt])
  @@map("notification_log")
}

// ---------- Phase 13b: saved searches and watched properties ----------

/// A search a person saved so they can be told about new matches. Only they can see or change it.
model SavedSearch {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  name       String
  purpose    String   @default("")
  city       String   @default("")
  q          String   @default("")
  maxKobo    BigInt?  @map("max_kobo")
  minBeds    Int?     @map("min_beds")
  alertsOn   Boolean  @default(true) @map("alerts_on")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([alertsOn, city])
  @@map("saved_searches")
}

/// A property a person is watching, to be told when it is no longer available or comes back.
model WatchedListing {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  listingId String   @map("listing_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, listingId])
  @@index([listingId])
  @@map("watched_listings")
}

// ---------- Phase 13: payments, invoices and the finance ledgers ----------

enum InvoicePurpose {
  SUBSCRIPTION
  AD_CAMPAIGN
}

enum BillingInvoiceStatus {
  OPEN
  PAID
  VOID
}

enum PaymentProviderKind {
  PAYSTACK
  MANUAL
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REVIEW
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
}

enum FinanceLedger {
  SUBSCRIPTION
  ADVERTISING
}

enum FinanceEntryKind {
  PAYMENT
  REFUND
  SPEND
  ADJUSTMENT
}

/// What someone owes the platform: a subscription period or an advertising budget. The amount is fixed when it is raised.
model Invoice {
  id           String            @id @default(uuid())
  ref          String            @unique
  purpose      InvoicePurpose
  ownerKind    SubscriptionOwner @map("owner_kind")
  ownerUserId  String?           @map("owner_user_id")
  ownerCompanyId String?         @map("owner_company_id")
  ownerName    String            @map("owner_name")
  subjectId    String            @map("subject_id")
  description  String
  amountKobo   BigInt            @map("amount_kobo")
  periodMonths Int               @default(0) @map("period_months")
  renewal      Boolean           @default(false)
  reminderStage String           @default("") @map("reminder_stage")
  status       BillingInvoiceStatus @default(OPEN)
  dueOn        DateTime?         @map("due_on")
  appliedAt    DateTime?         @map("applied_at")
  previousEnd  DateTime?         @map("previous_end")
  coversTo     DateTime?         @map("covers_to")
  paidAt       DateTime?         @map("paid_at")
  voidedAt     DateTime?         @map("voided_at")
  voidReason   String            @default("") @map("void_reason")
  createdById  String            @map("created_by_id")
  createdAt    DateTime          @default(now()) @map("created_at")
  payments     Payment[]
  refunds      Refund[]

  @@index([ownerUserId, createdAt])
  @@index([ownerCompanyId, createdAt])
  @@index([status, createdAt])
  @@index([purpose, subjectId])
  @@map("invoices")
}

/// One attempt to pay an invoice. Success is only ever set from a verified provider message, a verification call to the provider, or a person's recorded confirmation.
model Payment {
  id            String              @id @default(uuid())
  ref           String              @unique
  invoiceId     String              @map("invoice_id")
  provider      PaymentProviderKind
  providerRef   String?             @map("provider_ref")
  providerTxId  String              @default("") @map("provider_tx_id")
  amountKobo    BigInt              @map("amount_kobo")
  receivedKobo  BigInt?             @map("received_kobo")
  refundedKobo  BigInt              @default(0) @map("refunded_kobo")
  status        PaymentStatus       @default(PENDING)
  failureReason String              @default("") @map("failure_reason")
  reviewNote    String              @default("") @map("review_note")
  checkoutUrl   String              @default("") @map("checkout_url")
  initiatedById String              @map("initiated_by_id")
  createdAt     DateTime            @default(now()) @map("created_at")
  settledAt     DateTime?           @map("settled_at")
  invoice       Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  refunds       Refund[]

  @@unique([provider, providerRef])
  @@index([invoiceId])
  @@index([status, createdAt])
  @@map("payments")
}

/// Every message the provider sent that passed signature checks, once. The pair (provider, event id) is unique, so a repeated message is recognised and not processed again. Append-only.
model PaymentEvent {
  id          String              @id @default(uuid())
  provider    PaymentProviderKind
  eventId     String              @map("event_id")
  kind        String
  reference   String              @default("")
  amountKobo  BigInt?             @map("amount_kobo")
  outcome     String
  note        String              @default("")
  payloadHash String              @map("payload_hash")
  receivedAt  DateTime            @default(now()) @map("received_at")

  @@unique([provider, eventId])
  @@index([reference])
  @@index([receivedAt])
  @@map("payment_events")
}

/// Money given back. A full refund of a subscription payment takes back the time it bought; a refund of advertising covers only budget not yet spent.
model Refund {
  id            String       @id @default(uuid())
  ref           String       @unique
  paymentId     String       @map("payment_id")
  invoiceId     String       @map("invoice_id")
  amountKobo    BigInt       @map("amount_kobo")
  reason        String
  status        RefundStatus @default(PENDING)
  providerRef   String       @default("") @map("provider_ref")
  failureReason String       @default("") @map("failure_reason")
  requestedById String       @map("requested_by_id")
  createdAt     DateTime     @default(now()) @map("created_at")
  completedAt   DateTime?    @map("completed_at")
  payment       Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  invoice       Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([status, createdAt])
  @@map("refunds")
}

/// The platform's own books for subscriptions and advertising. Append-only. Each entry points to a verified provider event or to the person who authorised it; a mistake is corrected by a new entry, never by changing an old one.
/// Commissions, referral rewards and vacancy rewards keep their own ledgers where they already live.
model FinanceEntry {
  id         String           @id @default(uuid())
  ledger     FinanceLedger
  kind       FinanceEntryKind
  account    String
  amountKobo BigInt           @map("amount_kobo")
  entryKey   String?          @unique @map("entry_key")
  invoiceId  String?          @map("invoice_id")
  paymentId  String?          @map("payment_id")
  refundId   String?          @map("refund_id")
  campaignId String?          @map("campaign_id")
  eventId    String?          @map("event_id")
  actorId    String?          @map("actor_id")
  note       String           @default("")
  createdAt  DateTime         @default(now()) @map("created_at")

  @@index([ledger, createdAt])
  @@index([invoiceId])
  @@index([paymentId])
  @@index([campaignId])
  @@map("finance_entries")
}

// ---------- Phase 13: advertising ----------

enum AdPlacement {
  HOME_FEATURED
  SEARCH_TOP
}

enum AdStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  PAUSED
  SUSPENDED
  ENDED
}

/// One paid promotion of one published property in one place on the site. The budget is paid in advance, a click costs a fixed amount set when the campaign is made, and spending can never pass what was paid.
model AdCampaign {
  id             String            @id @default(uuid())
  ref            String            @unique
  ownerKind      SubscriptionOwner @map("owner_kind")
  ownerUserId    String?           @map("owner_user_id")
  ownerCompanyId String?           @map("owner_company_id")
  createdById    String            @map("created_by_id")
  name           String
  listingId      String            @map("listing_id")
  placement      AdPlacement
  headline       String            @default("")
  startsOn       DateTime          @map("starts_on")
  endsOn         DateTime          @map("ends_on")
  budgetKobo     BigInt            @map("budget_kobo")
  dailyCapKobo   BigInt?           @map("daily_cap_kobo")
  cpcKobo        BigInt            @map("cpc_kobo")
  status         AdStatus          @default(DRAFT)
  reviewNote     String            @default("") @map("review_note")
  reviewedById   String?           @map("reviewed_by_id")
  reviewedAt     DateTime?         @map("reviewed_at")
  submittedAt    DateTime?         @map("submitted_at")
  suspendedBy    String            @default("") @map("suspended_by")
  suspendReason  String            @default("") @map("suspend_reason")
  suspendedAt    DateTime?         @map("suspended_at")
  endedReason    String            @default("") @map("ended_reason")
  invoiceId      String?           @unique @map("invoice_id")
  fundedKobo     BigInt            @default(0) @map("funded_kobo")
  spentKobo      BigInt            @default(0) @map("spent_kobo")
  postedKobo     BigInt            @default(0) @map("posted_kobo")
  impressions    Int               @default(0)
  clicks         Int               @default(0)
  billedClicks   Int               @default(0) @map("billed_clicks")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  listing        Listing           @relation(fields: [listingId], references: [id], onDelete: Restrict)
  days           AdDay[]
  clickRows      AdClick[]

  @@index([status, placement])
  @@index([ownerCompanyId, createdAt])
  @@index([ownerUserId, createdAt])
  @@index([listingId])
  @@map("ad_campaigns")
}

/// Shown, clicked and spent, by day (Lagos). Counters only; each billed click is kept in full in ad_clicks.
model AdDay {
  campaignId   String     @map("campaign_id")
  day          String
  impressions  Int        @default(0)
  clicks       Int        @default(0)
  billedClicks Int        @default(0) @map("billed_clicks")
  spentKobo    BigInt     @default(0) @map("spent_kobo")
  campaign     AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@id([campaignId, day])
  @@map("ad_days")
}

/// Every click on an advert, with whether it was paid for and if not why. The visitor is a daily-changing hash, never an address. Append-only.
model AdClick {
  id         String     @id @default(uuid())
  campaignId String     @map("campaign_id")
  viewerKey  String     @map("viewer_key")
  userId     String?    @map("user_id")
  billed     Boolean
  reason     String     @default("")
  createdAt  DateTime   @default(now()) @map("created_at")
  campaign   AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, viewerKey, createdAt])
  @@index([campaignId, createdAt])
  @@map("ad_clicks")
}

/// One visit to a property page by one visitor on one day, and whether it came from an advert or not. This is what lets paid and organic attention be told apart.
model ListingViewKey {
  listingId String @map("listing_id")
  day       String
  viewerKey String @map("viewer_key")
  via       String

  @@id([listingId, day, viewerKey])
  @@index([listingId, day])
  @@map("listing_view_keys")
}


// ---------- Phase 14: AI assistance, analytics and location ----------

enum AiRunStatus {
  OK
  FALLBACK
  ERROR
  LIMITED
  DENIED
}

enum AiSuggestionKind {
  DOCUMENT_CATEGORY
  CORRESPONDENCE_SUMMARY
}

enum AiSuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

/// One use of the assistant, kept for audit. It records what was asked of which feature and what happened, never the text itself.
model AiRun {
  id          String      @id @default(uuid())
  companyId   String?     @map("company_id")
  userId      String?     @map("user_id")
  visitorKey  String      @default("") @map("visitor_key")
  feature     String
  provider    String
  status      AiRunStatus
  inputChars  Int         @default(0) @map("input_chars")
  outputChars Int         @default(0) @map("output_chars")
  ms          Int         @default(0)
  subjectType String      @default("") @map("subject_type")
  subjectId   String      @default("") @map("subject_id")
  note        String      @default("")
  createdAt   DateTime    @default(now()) @map("created_at")

  @@index([companyId, createdAt])
  @@index([userId, createdAt])
  @@index([feature, createdAt])
  @@map("ai_runs")
}

/// Something the assistant (or the built-in rules) proposes. It changes nothing until a person with the right role accepts it.
model AiSuggestion {
  id           String             @id @default(uuid())
  companyId    String             @map("company_id")
  kind         AiSuggestionKind
  subjectType  String             @map("subject_type")
  subjectId    String             @map("subject_id")
  payload      Json
  source       String
  confidence   Int                @default(0)
  status       AiSuggestionStatus @default(PENDING)
  createdById  String             @map("created_by_id")
  reviewedById String?            @map("reviewed_by_id")
  reviewedAt   DateTime?          @map("reviewed_at")
  reviewNote   String             @default("") @map("review_note")
  createdAt    DateTime           @default(now()) @map("created_at")

  @@index([companyId, status])
  @@index([subjectType, subjectId])
  @@map("ai_suggestions")
}

/// A one-time link to choose a new password. Only the hash of the token is stored.
model PasswordReset {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_resets")
}

/// One-time codes for when the authenticator is lost. Only hashes are stored.
model MfaRecovery {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("mfa_recoveries")
}

enum ImportKind {
  ASSETS
  LEASES
}

enum ImportBatchStatus {
  PREVIEWED
  COMMITTED
  DISCARDED
}

enum ImportRowStatus {
  READY
  DUPLICATE
  ERROR
  IMPORTED
  FAILED
}

/// One file of existing records being brought in. Shown as a preview first; nothing is created until a person confirms.
model ImportBatch {
  id          String            @id @default(uuid())
  companyId   String            @map("company_id")
  ref         String
  kind        ImportKind
  fileName    String            @map("file_name")
  status      ImportBatchStatus @default(PREVIEWED)
  note        String            @default("")
  createdById String            @map("created_by_id")
  committedById String?         @map("committed_by_id")
  committedAt DateTime?         @map("committed_at")
  createdAt   DateTime          @default(now()) @map("created_at")

  @@unique([companyId, ref])
  @@index([companyId, createdAt])
  @@map("import_batches")
}

/// One line of the file, with what was decided about it and, once imported, the record it became.
model ImportRow {
  id        String          @id @default(uuid())
  companyId String          @map("company_id")
  batchId   String          @map("batch_id")
  rowNo     Int             @map("row_no")
  status    ImportRowStatus
  message   String          @default("")
  payload   Json
  entityId  String?         @map("entity_id")
  createdAt DateTime        @default(now()) @map("created_at")

  @@unique([batchId, rowNo])
  @@index([companyId, batchId, status])
  @@map("import_rows")
}

/// A key that lets another program read a company's records through the API. Only the hash of the key is stored.
model ApiKey {
  id          String    @id @default(uuid())
  companyId   String    @map("company_id")
  createdById String    @map("created_by_id")
  name        String
  prefix      String
  tokenHash   String    @unique @map("token_hash")
  scopes      String
  expiresAt   DateTime? @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  lastUsedAt  DateTime? @map("last_used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([companyId])
  @@map("api_keys")
}

/// A partner organisation shown on the public pages. Added only by platform administrators after a real agreement exists; never invented.
model Partner {
  id        String   @id @default(uuid())
  name      String
  kind      String
  url       String   @default("")
  blurb     String   @default("")
  logoMime  String?  @map("logo_mime")
  logoBytes Bytes?   @map("logo_bytes")
  active    Boolean  @default(true)
  position  Int      @default(0)
  addedById String   @map("added_by_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("partners")
}

/// One identity or business check (KYC) for a company or an agent. ID numbers are stored only encrypted; documents are never public.
model KycItem {
  id            String    @id @default(uuid())
  companyId     String    @map("company_id")
  subjectKind   String    @map("subject_kind")
  subjectKey    String    @map("subject_key")
  subjectUserId String?   @map("subject_user_id")
  code          String
  status        String    @default("SUBMITTED")
  fields        Json      @default("{}")
  secretSealed  String?   @map("secret_sealed")
  secretMasked  String    @default("") @map("secret_masked")
  docMime       String?   @map("doc_mime")
  docBytes      Bytes?    @map("doc_bytes")
  docName       String    @default("") @map("doc_name")
  submittedById String    @map("submitted_by_id")
  submittedAt   DateTime  @default(now()) @map("submitted_at")
  reviewedById  String?   @map("reviewed_by_id")
  reviewedAt    DateTime? @map("reviewed_at")
  reviewNote    String    @default("") @map("review_note")
  scope         String    @default("")
  evidence      String    @default("")
  limitations   String    @default("")
  verifiedAt    DateTime? @map("verified_at")
  expiresAt     DateTime? @map("expires_at")
  autoConsent   Boolean   @default(false) @map("auto_consent")
  autoOutcome   String    @default("NONE") @map("auto_outcome")
  autoProvider  String    @default("") @map("auto_provider")
  autoReference String    @default("") @map("auto_reference")
  autoNote      String    @default("") @map("auto_note")
  autoAt        DateTime? @map("auto_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([subjectKey, code])
  @@index([companyId])
  @@index([status, submittedAt])
  @@index([autoOutcome])
  @@map("kyc_items")
}

/// The public result of the checks: which checks passed, when, and until when. Anyone may read it; only reviewers change it.
model TrustScore {
  id            String   @id @default(uuid())
  subjectKey    String   @unique @map("subject_key")
  subjectKind   String   @map("subject_kind")
  companyId     String   @map("company_id")
  subjectUserId String?  @map("subject_user_id")
  checks        Json     @default("[]")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([subjectUserId])
  @@map("trust_scores")
}

/// A request to inspect (view) a published property, and its journey from request to completion (master prompt §29).
model InspectionBooking {
  id              String    @id @default(uuid())
  ref             String    @unique
  companyId       String    @map("company_id")
  listingId       String    @map("listing_id")
  requesterId     String    @map("requester_id")
  requesterName   String    @map("requester_name")
  requesterPhone  String    @default("") @map("requester_phone")
  message         String    @default("")
  preferredAt     DateTime  @map("preferred_at")
  alternativeAt   DateTime? @map("alternative_at")
  scheduledAt     DateTime? @map("scheduled_at")
  durationMinutes Int       @default(60) @map("duration_minutes")
  assignedUserId  String?   @map("assigned_user_id")
  meetingPoint    String    @default("") @map("meeting_point")
  status          String    @default("REQUESTED")
  cancelReason    String    @default("") @map("cancel_reason")
  outcome         String    @default("")
  rescheduleCount Int       @default(0) @map("reschedule_count")
  remindedAt      DateTime? @map("reminded_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([companyId, scheduledAt])
  @@index([requesterId])
  @@index([assignedUserId, scheduledAt])
  @@map("inspection_bookings")
}

/// Every step of a booking, kept for both sides to see.
model InspectionBookingEvent {
  id          String   @id @default(uuid())
  bookingId   String   @map("booking_id")
  companyId   String   @map("company_id")
  requesterId String   @map("requester_id")
  actorId     String   @map("actor_id")
  fromStatus  String   @map("from_status")
  toStatus    String   @map("to_status")
  note        String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([bookingId, createdAt])
  @@map("inspection_booking_events")
}

/// A consented safety session for one person at one inspection: location while it is on, check-in and out, and emergency alerts.
model SafetySession {
  id             String    @id @default(uuid())
  bookingId      String    @map("booking_id")
  userId         String    @map("user_id")
  companyId      String?   @map("company_id")
  shareTokenHash String?   @unique @map("share_token_hash")
  trustedName    String    @default("") @map("trusted_name")
  trustedPhone   String    @default("") @map("trusted_phone")
  trustedEmail   String    @default("") @map("trusted_email")
  consentVersion String    @map("consent_version")
  consentAt      DateTime  @map("consent_at")
  startedAt      DateTime  @default(now()) @map("started_at")
  expectedEndAt  DateTime  @map("expected_end_at")
  checkedInAt    DateTime? @map("checked_in_at")
  checkedOutAt   DateTime? @map("checked_out_at")
  endedAt        DateTime? @map("ended_at")
  endReason      String    @default("") @map("end_reason")
  emergencyAt    DateTime? @map("emergency_at")
  emergencyNote  String    @default("") @map("emergency_note")
  lastLat        Float?    @map("last_lat")
  lastLng        Float?    @map("last_lng")
  lastAt         DateTime? @map("last_at")

  @@index([userId, startedAt])
  @@index([companyId, startedAt])
  @@index([bookingId])
  @@map("safety_sessions")
}

/// One location point during a live safety session. Deleted 30 days after the session ends.
model SafetyPing {
  id        String   @id @default(uuid())
  sessionId String   @map("session_id")
  userId    String   @map("user_id")
  companyId String?  @map("company_id")
  lat       Float
  lng       Float
  accuracy  Float?
  at        DateTime @default(now())

  @@index([sessionId, at])
  @@map("safety_pings")
}

/// A report to the Trust and Safety Centre (master prompt §40) and how it was handled.
model TrustCase {
  id                 String    @id @default(uuid())
  ref                String    @unique
  reporterId         String    @map("reporter_id")
  category           String
  severity           String
  status             String    @default("OPEN")
  targetKind         String    @default("OTHER") @map("target_kind")
  targetRef          String    @default("") @map("target_ref")
  description        String
  assignedToId       String?   @map("assigned_to_id")
  dueAt              DateTime  @map("due_at")
  outcomeForReporter String    @default("") @map("outcome_for_reporter")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  closedAt           DateTime? @map("closed_at")

  @@index([status, dueAt])
  @@index([reporterId])
  @@map("trust_cases")
}

model TrustCaseEvidence {
  id         String   @id @default(uuid())
  caseId     String   @map("case_id")
  reporterId String   @map("reporter_id")
  name       String
  mimeType   String   @map("mime_type")
  bytes      Bytes
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([caseId])
  @@map("trust_case_evidence")
}

/// Everything that happened on a case. Lines marked toReporter are shown to the person who reported.
model TrustCaseEvent {
  id         String   @id @default(uuid())
  caseId     String   @map("case_id")
  reporterId String   @map("reporter_id")
  actorId    String   @map("actor_id")
  kind       String
  body       String   @default("")
  toReporter Boolean  @default(false) @map("to_reporter")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([caseId, createdAt])
  @@map("trust_case_events")
}

/// Reference values the platform administrators can rename, hide, reorder and add to (master prompt §3.1, §8.2):
/// property types (rename, hide, reorder), amenities and title documents (also add, optionally for one country).
model ReferenceItem {
  id        String   @id @default(uuid())
  kind      String
  code      String
  label     String
  active    Boolean  @default(true)
  position  Int      @default(0)
  country   String   @default("")
  updatedById String @map("updated_by_id")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([kind, code])
  @@map("reference_items")
}

/// A platform administrator's time-limited access to one company's records, with the purpose stated. The company can see these.
model AdminAccessGrant {
  id        String   @id @default(uuid())
  adminId   String   @map("admin_id")
  companyId String   @map("company_id")
  purpose   String
  caseRef   String   @default("") @map("case_ref")
  note      String   @default("")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@index([companyId, createdAt])
  @@index([adminId, expiresAt])
  @@map("admin_access_grants")
}

/// Access a company gives an outside person to a portal (master prompt §39): an owner to chosen assets, or a vendor to its contractor record.
model PortalGrant {
  id              String    @id @default(uuid())
  companyId       String    @map("company_id")
  kind            String
  email           String
  displayName     String    @map("display_name")
  userId          String?   @map("user_id")
  contractorId    String?   @map("contractor_id")
  inviteTokenHash String?   @unique @map("invite_token_hash")
  inviteExpiresAt DateTime? @map("invite_expires_at")
  status          String    @default("INVITED")
  createdById     String    @map("created_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  acceptedAt      DateTime? @map("accepted_at")
  revokedAt       DateTime? @map("revoked_at")

  @@index([companyId, kind])
  @@index([userId])
  @@map("portal_grants")
}

/// The assets an owner may see through the owner portal.
model PortalGrantAsset {
  id        String @id @default(uuid())
  grantId   String @map("grant_id")
  companyId String @map("company_id")
  assetId   String @map("asset_id")

  @@unique([grantId, assetId])
  @@index([companyId])
  @@map("portal_grant_assets")
}

/// What a vendor keeps up to date about itself, and its compliance documents.
model VendorProfile {
  id             String   @id @default(uuid())
  grantId        String   @unique @map("grant_id")
  companyId      String   @map("company_id")
  userId         String   @map("user_id")
  serviceAreas   String   @default("") @map("service_areas")
  qualifications String   @default("")
  insuranceNote  String   @default("") @map("insurance_note")
  docName        String   @default("") @map("doc_name")
  docMime        String?  @map("doc_mime")
  docBytes       Bytes?   @map("doc_bytes")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("vendor_profiles")
}

/// A vendor's quotation, invoice or completion report on a work order assigned to it. The company accepts or rejects it.
model VendorSubmission {
  id          String    @id @default(uuid())
  companyId   String    @map("company_id")
  workOrderId String    @map("work_order_id")
  grantId     String    @map("grant_id")
  userId      String    @map("user_id")
  kind        String
  amountKobo  BigInt?   @map("amount_kobo")
  note        String    @default("")
  docName     String    @default("") @map("doc_name")
  docMime     String?   @map("doc_mime")
  docBytes    Bytes?    @map("doc_bytes")
  status      String    @default("SUBMITTED")
  decidedById String?   @map("decided_by_id")
  decidedAt   DateTime? @map("decided_at")
  decisionNote String   @default("") @map("decision_note")
  paidOn         DateTime? @map("paid_on") @db.Date
  paidAmountKobo BigInt?   @map("paid_amount_kobo")
  paidReference  String    @default("") @map("paid_reference")
  paidById       String?   @map("paid_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([companyId, workOrderId])
  @@index([grantId])
  @@map("vendor_submissions")
}

/// People who work for a verification or professional service provider (master prompt §9, §39), added by platform administrators.
model ProviderMember {
  id         String   @id @default(uuid())
  providerId String   @map("provider_id")
  userId     String   @map("user_id")
  addedById  String   @map("added_by_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([providerId, userId])
  @@index([userId])
  @@map("provider_members")
}

/// A private calendar feed link: a calendar app subscribes to it to see the person's inspections. Only the hash of the link's secret is kept.
model CalendarFeed {
  id         String    @id @default(uuid())
  userId     String    @unique @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("calendar_feeds")
}

/// A browser or installed app that agreed to receive push notifications for this person.
model PushSubscription {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  endpoint      String    @unique
  p256dh        String
  auth          String
  label         String    @default("")
  failures      Int       @default(0)
  lastSuccessAt DateTime? @map("last_success_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("push_subscriptions")
}

/// Notifications waiting to be pushed to the person's devices. Written with the notification; sent by a job every minute.
model PushOutbox {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  title     String
  body      String    @default("")
  link      String    @default("")
  kind      String
  createdAt DateTime  @default(now()) @map("created_at")
  sentAt    DateTime? @map("sent_at")
  attempts  Int       @default(0)

  @@index([sentAt, createdAt])
  @@map("push_outbox")
}

/// A person's flatmate profile. Seen only by other signed-in people who have an active profile themselves.
model FlatmateProfile {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id")
  status           String   @default("ACTIVE")
  displayName      String   @map("display_name")
  intent           String
  country          String   @default("NG")
  city             String
  areas            String   @default("")
  budgetMinKobo    BigInt   @map("budget_min_kobo")
  budgetMaxKobo    BigInt   @map("budget_max_kobo")
  moveInFrom       DateTime @map("move_in_from") @db.Date
  stayMonths       Int?     @map("stay_months")
  ageBand          String   @map("age_band")
  agePref          String   @default("ANY") @map("age_pref")
  gender           String   @default("UNSAID")
  genderPref       String   @default("ANY") @map("gender_pref")
  showGender       Boolean  @default(false) @map("show_gender")
  answers          Json
  mustMatch        String   @default("") @map("must_match")
  occupation       String   @default("")
  about            String   @default("")
  roomListingRef   String   @default("") @map("room_listing_ref")
  adultConfirmedAt DateTime @map("adult_confirmed_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([status, country, city])
  @@map("flatmate_profiles")
}

/// A request to match. When the other person accepts, the two are matched and taken into a chat room together.
model FlatmateRequest {
  id         String    @id @default(uuid())
  fromUserId String    @map("from_user_id")
  toUserId   String    @map("to_user_id")
  score      Int
  note       String    @default("")
  status     String    @default("PENDING")
  roomId     String?   @map("room_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  decidedAt  DateTime? @map("decided_at")

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
  @@map("flatmate_requests")
}

/// The chat room matched flatmates are taken into: a private conversation that matched people can be added to (up to six).
model FlatmateRoom {
  id             String       @id @default(uuid())
  conversationId String       @unique @map("conversation_id")
  createdById    String       @map("created_by_id")
  status         String       @default("OPEN")
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("flatmate_rooms")
}

/// People a person never wants to see in their matches.
model FlatmateHide {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  hiddenUserId String   @map("hidden_user_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([userId, hiddenUserId])
  @@map("flatmate_hides")
}
